            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "symbol"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "number"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "nil"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "function_reference"
            },
            "value": {
              "const": "source_callback_not_executed"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fact"
              }
            }
          },
          "required": [
            "kind",
            "items"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "object"
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/fact"
              }
            }
          },
          "required": [
            "kind",
            "fields"
          ]
        }
      ]
    }
  }
}
