      "resolution": "Native source qualification: {\"family_module\": \"native_delayed\", \"observations\": {\"approved_omissions\": [{\"field\": \"value_timing\", \"selection_rule\": \"WIKI:raw_damage_at_cast\", \"source\": \"canary\", \"status\": \"approved_omission\", \"value\": \"at_expiry\"}, {\"field\": \"value_timing\", \"selection_rule\": \"WIKI:raw_damage_at_cast\", \"source\": \"crystal\", \"status\": \"approved_omission\", \"value\": \"at_expiry\"}, {\"field\": \"formula_stage_multiplier\", \"selection_rule\": \"WIKI:0_16_32_percent\", \"source\": \"canary\", \"status\": \"approved_omission\", \"value\": [\"1.3\", \"1.6\", \"2.0\"]}, {\"field\": \"formula_stage_multiplier\", \"selection_rule\": \"WIKI:0_16_32_percent\", \"source\": \"crystal\", \"status\": \"approved_omission\", \"value\": [\"1.3\", \"1.6\", \"2.0\"]}, {\"field\": \"engine_stage_bonus_percent\", \"selection_rule\": \"WIKI:0_16_32_percent\", \"source\": \"canary\", \"status\": \"approved_omission\", \"value\": [30, 60, 100]}, {\"field\": \"placement_gate\", \"selection_rule\": \"S21\", \"source\": \"crystal\", \"status\": \"approved_omission\", \"value\": \"walkable_non_house_non_pz\"}, {\"field\": \"range\", \"selection_rule\": \"WIKI/S21:4\", \"source\": \"crystal\", \"status\": \"approved_omission\", \"value\": 7}], \"commitment\": {\"anchor\": \"requires_owned_native_contract\", \"cooldown_occurrences\": 1, \"cost_occurrences\": 1, \"refund_after_committed_effect\": false}, \"runtime_admission\": \"rejected_until_native_contract\", \"selection_rule\": \"WIKI/S21/S5/S24\", \"source_evidence\": [{\"authority\": \"OtsHypothesisOnly\", \"path\": \"data/scripts/spells/attack/divine_grenade.lua\", \"revision\": \"99902524e052f37574194466c2949c576e4ab269\", \"sha256\": \"4db33a343efa3f45ae5ec968fa37916b0934c7d279dcae9bb7a1a79fc7921e00\", \"source\": \"canary\"}, {\"authority\": \"OtsHypothesisOnly\", \"path\": \"data/scripts/spells/attack/divine_grenade.lua\", \"revision\": \"ff7ede593c69d4c6