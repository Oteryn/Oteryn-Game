{
  "fixture_set": "oteryn.premium_snapshot.v1",
  "coordination_id": "OTV2-PREMIUM-DELIVERY",
  "contract": "docs/contracts/OTERYN_V2_PREMIUM_TIME_SNAPSHOT_CONTRACT.md",
  "policy": {
    "max_authority_lease_seconds": 3600,
    "refresh_fraction": "2/3",
    "max_clock_skew_seconds": 5,
    "stale_within_bound": "DENY",
    "max_response_bytes": 1024,
    "max_request_bytes": 256
  },
  "request_schema": "request.schema.json",
  "snapshot_schema": "snapshot.schema.json",
  "valid_request": "request.valid.json",
  "valid_snapshots": [
    {
      "file": "snapshot.active.json",
      "entitlement_state": "ACTIVE",
      "expected_consumer_classification": "CURRENT_AUTHORITY while trusted time is within [effective_from, refresh_after) conservatively; STALE_WITHIN_BOUND (deny) from refresh_after and EXPIRED from authority_valid_until without newer evidence; full 3600 s lease"
    },
    {
      "file": "snapshot.active-clipped.json",
      "entitlement_state": "ACTIVE",
      "expected_consumer_classification": "CURRENT_AUTHORITY before refresh_after; lease clipped to commercial effective_until, refresh at two thirds of the clipped lease"
    },
    {
      "file": "snapshot.expired.json",
      "entitlement_state": "EXPIRED",
      "expected_consumer_classification": "EXPIRED; deny benefit"
    },
    {
      "file": "snapshot.revoked.json",
      "entitlement_state": "REVOKED",
      "expected_consumer_classification": "REVOKED; deny benefit and fence older lifecycle revisions"
    },
    {
      "file": "snapshot.none.json",
      "entitlement_state": "NONE",
      "expected_consumer_classification": "NONE; no entitlement, deny benefit"
    }
  ],
  "cross_field_rules": [
    "nonce and account_id equal the request values byte for byte",
    "entitlement_state NONE iff entitlement_id, effective_from and effective_until are null and lifecycle_revision is 0",
    "effective_from < effective_until when not null",
    "authority_issued_at <= refresh_after < authority_valid_until <= authority_issued_at + 3600 s",
    "ACTIVE and NOT_YET_EFFECTIVE: authority_valid_until = min(authority_issued_at + 3600 s, effective_until)",
    "EXPIRED, REVOKED and NONE: authority_valid_until = authority_issued_at + 3600 s",
    "refresh_after = authority_issued_at + floor(2 * (authority_valid_until - authority_issued_at) / 3) seconds",
    "ACTIVE: effective_from <= authority_issued_at < effective_until",
    "NOT_YET_EFFECTIVE: authority_issued_at < effective_from",
    "EXPIRED: authority_issued_at >= effective_until",
    "serialized UTF-8 body is at most 1024 bytes"
  ],
