{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oteryn.invalid/schemas/oteryn.premium_snapshot_request.v1.json",
  "title": "oteryn.premium_snapshot_request.v1",
  "description": "Request body for POST /internal/v1/products-entitlements/premium-snapshots/read. Serialized body is at most 256 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "account_id",
    "nonce"
  ],
  "properties": {
    "schema": {
      "const": "oteryn.premium_snapshot_request.v1"
    },
    "account_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  }
}
