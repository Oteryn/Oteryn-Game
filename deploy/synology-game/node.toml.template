# Mode 0600, owned by the runner user. Replace every <PLACEHOLDER>; no secrets inline.
# The deploy workflow rewrites authorization_file on every deploy.
# Local ANL custody, independent of Platform availability. The service user owns this directory.
[audit_collector]
enabled = true
directory = "<BASE>/node/audit"
batch_size = 32
interval_ms = 1000
rotation_bytes = 16777216
rotation_count = 4
[listener]
address = "<LISTEN_ADDRESS>:<GAME_PORT>"
entry_deadline_ms = 20000
max_connections = 256
max_handshake_units = 64
certificate_chain_file = "<BASE>/node/secrets/gameplay.crt"
private_key_file = "<BASE>/node/secrets/gameplay.key"
[scope]
world_id = "<WORLD_ID>"
channel_id = "<CHANNEL_ID>"
assignment_wait_ms = 120000
preproduction_actor_capacity = 131072
[database]
transport_ip = "<DB_IP>"
port = <DB_PORT>
tls_server_name = "<DB_TLS_SERVER_NAME>"
database = "<DB_NAME>"
username = "<RUNTIME_ROLE>"
password_file = "<BASE>/node/secrets/pg-password"
root_ca_file = "<BASE>/node/secrets/db-ca.pem"
# Optional (NODE-BOOT-DEADLINE-1): the PostgreSQL pass deadline for the boot durability steps only
# (S2 custody read/claim/descriptor, Character authority open), 2000..=60000 ms, default 2000 when
# the table is absent. Gameplay passes keep the fixed 2 s deadline. A loaded host needs the margin.
[boot]
pass_deadline_ms = 15000
[character]
fence_directory = "<BASE>/fence-parent/fence"
authority_scope_id = "character-primary"
issuer_identity = "game-ops"
[control]
socket_path = "<BASE>/run/control.sock"
[readiness]
source_authority = "<READINESS_SOURCE_AUTHORITY>"
route_revision = "<ROUTE_REVISION>"
runtime_observation_revision = "<RUNTIME_OBSERVATION_REVISION>"
ruleset_revision = "<RULESET_REVISION>"
content_revision = "<CONTENT_REVISION>"
map_revision = "<MAP_REVISION>"
world_policy_revision = "<WORLD_POLICY_REVISION>"
offer_revision = "<OFFER_REVISION>"
[platform]
source_authority = "platform"
endpoint = "<PLATFORM_ENDPOINT>"
peer_name = "<PLATFORM_PEER_NAME>"
trust_roots_file = "<BASE>/node/secrets/platform-roots.pem"
client_certificate_file = "<BASE>/node/secrets/platform-client.crt"
client_key_file = "<BASE>/node/secrets/platform-client.key"
descriptor_revision = 1
installed_at = <UNIX_SECONDS_AT_SETUP>
[platform.runtime_status]
# The node host's own runtime-status identity, never the evidence one above.
client_certificate_file = "<BASE>/node/secrets/runtime-status.crt"
client_key_file = "<BASE>/node/secrets/runtime-status.key"
assignment_epoch = <ASSIGNMENT_EPOCH>
[platform.account_characters]
# The Character projection identity (CN=<PROJECTION_IDENTITY>), distinct from the evidence and
# runtime-status ones. F is the contract §5 epoch fence, outside the Character fence directory.
client_certificate_file = "<BASE>/node/secrets/projection.crt"
client_key_file = "<BASE>/node/secrets/projection.key"
source_authority = "<PROJECTION_SOURCE_AUTHORITY>"
epoch_fence_file = "<BASE>/projection/epoch-fence"
# Character command receipts keep this dedicated identity. Owner instruction
# for GPROD-BAZAAR enables the producer; provision both purposes on Platform.
[platform.character_commands]
client_certificate_file = "<BASE>/node/secrets/character-commands.crt"
client_key_file = "<BASE>/node/secrets/character-commands.key"
source_authority = "oteryn:character-authority:primary"
[platform.bazaar]
# Dedicated Bazaar certificate/key, never the Character receipt/evidence pair.
# Explicit false pauses new decisions while retained custody/receipts reconcile.
enabled = true
client_certificate_file = "<BASE>/node/secrets/bazaar.crt"
client_key_file = "<BASE>/node/secrets/bazaar.key"
source_authority = "oteryn:game:primary"
# PUBPROJ owner 2026-11-07: install the purpose-separated identity before enabling.
# Reuses the Platform endpoint and trust roots; never shares the LCFA epoch fence.
[platform.public_projections]
enabled = false
character_online_sessions_enabled = false
world_daily_kills_enabled = false
source_authority = "oteryn:game:primary"
client_certificate_file = "<BASE>/node/secrets/public-projections.crt"
client_key_file = "<BASE>/node/secrets/public-projections.key"
epoch_fence_file = "<BASE>/public-projections/epoch-fence"
# T94 owner 2026-11-06: enabled by default, with a dedicated mTLS identity.
[platform.world_event_outcomes]
enabled = true
source_authority = "oteryn:game:primary"
client_certificate_file = "<BASE>/node/secrets/t94-client.crt"
client_key_file = "<BASE>/node/secrets/t94-client.key"
epoch_fence_file = "<BASE>/t94/epoch-fence"
[launch]
authorization_file = "<BASE>/state/launch-initial.json"
s2_authorization_file = "<BASE>/state/s2-fresh-store.json"
# Opt-in World Bundle (preproduction only; production is refused by the node). Enable it by appending
# the [world_bundle] table of preprod-topology.toml with <BASE> replaced and, in [readiness],
# map_revision = "<digest>". deploy-ops.sh check-setup refuses any difference from the manifest.
# Without the table the node serves the fixture entry room.
# NPC catalogue (NPC-LOAD-1): not a node.toml key. It is two command-line flags, --npc-data-project and
# --npc-data-sha256, which supervisor.sh passes when the deploy staged BASE/run/npc-data (npc-data.pin.json).
