{
  "schema_version": "1.0",
  "ruleset_name": "Protect main",
  "required_status_check": "game-gate",
  "licensing": {
    "spdx_id": "MPL-2.0",
    "license_file": "LICENSE",
    "scope_policy": "docs/repository/LICENSING.md",
    "reserved_assets_notice": "LICENSE-ASSETS.md",
    "trademark_notice": "TRADEMARKS.md",
    "incompatible_with_secondary_licenses": false
  },
  "repository": {
    "allow_auto_merge": true,
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "delete_branch_on_merge": true,
    "allow_update_branch": true,
    "use_squash_pr_title_as_default": true,
    "squash_merge_commit_title": "PR_TITLE",
    "squash_merge_commit_message": "PR_BODY",
    "has_issues": true,
    "has_projects": true,
    "has_wiki": false,
    "description": "Greenfield native Rust multichannel game server, client, protocol, content, and tooling platform."
  },
  "topics": [
    "rust",
    "game-engine",
    "game-server",
    "mmorpg",
    "multichannel",
    "oteryn"
  ],
  "labels": [
    {
      "name": "dependencies",
      "color": "0366d6",
      "description": "Dependency updates"
    },
    {
      "name": "ci",
      "color": "1d76db",
      "description": "Continuous integration and automation"
    },
    {
      "name": "security",
      "color": "b60205",
      "description": "Security-sensitive work"
    },
    {
      "name": "architecture",
      "color": "5319e7",
      "description": "Architecture and public contracts"
    },
    {
      "name": "priority:high",
      "color": "d93f0b",
      "description": "High-priority work"
    },
    {
      "name": "risk:high",
      "color": "b60205",
      "description": "High-risk change requiring additional scrutiny"
    }
  ],
  "actions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "security": {
    "vulnerability_alerts": true,
    "automated_security_fixes": true,
    "private_vulnerability_reporting": true,
    "secret_scanning": "enabled",
    "secret_scanning_push_protection": "enabled"
  },
  "ruleset": {
    "name": "Protect main",
    "target": "branch",
    "enforcement": "active",
    "bypass_actors": [],
    "conditions": {
      "ref_name": {
        "include": [
          "~DEFAULT_BRANCH"
        ],
        "exclude": []
      }
    },
    "rules": [
      {
        "type": "deletion"
      },
      {
        "type": "required_linear_history"
      },
      {
        "type": "pull_request",
        "parameters": {
          "allowed_merge_methods": [
            "squash"
          ],
          "dismiss_stale_reviews_on_push": true,
          "require_code_owner_review": false,
          "require_last_push_approval": false,
          "required_approving_review_count": 0,
          "required_review_thread_resolution": true
        }
      },
      {
        "type": "merge_queue",
        "parameters": {
          "check_response_timeout_minutes": 60,
          "grouping_strategy": "ALLGREEN",
          "max_entries_to_build": 5,
          "max_entries_to_merge": 5,
          "merge_method": "SQUASH",
          "min_entries_to_merge": 1,
          "min_entries_to_merge_wait_minutes": 0
        }
      },
      {
        "type": "required_status_checks",
        "parameters": {
          "do_not_enforce_on_create": false,
          "required_status_checks": [
            {
              "context": "game-gate"
            }
          ],
          "strict_required_status_checks_policy": false
        }
      },
      {
        "type": "non_fast_forward"
      }
    ]
  },
  "control_plane_protection": {
    "public_repository_strategy": "explicit_owner_authorization_plus_merge_queue",
    "code_owner": "@blakinio",
    "protected_paths": [
      ".github/CODEOWNERS",
      ".github/workflows/",
      ".github/repository-policy.json",
      "tools/repository/"
    ],
    "push_ruleset_private_internal_only": true,
    "break_glass": "capture current live ruleset, make only the explicitly authorized bounded mutation, restore and positively read back the snapshot on any unsuccessful exit"
  },
  "push_ruleset": {
    "name": "Protect repository control plane",
    "target": "push",
    "enforcement": "active",
    "bypass_actors": [],
    "rules": [
      {
        "type": "file_path_restriction",
        "parameters": {
          "restricted_file_paths": [
            ".github/workflows/*",
            ".github/workflows/**/*",
            ".github/repository-policy.json",
            "tools/repository/*",
            "tools/repository/**/*"
          ]
        }
      }
    ]
  }
}
