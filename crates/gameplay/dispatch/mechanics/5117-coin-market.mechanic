name=coin_market
commands=6128
transport=coin_market
composed=coin_market
authority=coin_market
[route]
{
 match authority.coin_market_command(session.admitted,command.command_id,command.payload).await {
    Some(bytes) => Dispatch::Reply(CommandStatus::Accepted, bytes),
    None => command_unavailable(command, "coin_market_outcome_unavailable"),
 }
}
