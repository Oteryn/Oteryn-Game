name=coin_transfer
commands=6127
transport=coin_transfer
composed=coin_transfer
authority=coin_transfer
[route]
{
 match authority.coin_transfer_command(session.admitted,command.command_id,command.payload).await {
    Some(bytes) => Dispatch::Reply(CommandStatus::Accepted, bytes),
    None => command_unavailable(command, "coin_transfer_outcome_unavailable"),
 }
}
