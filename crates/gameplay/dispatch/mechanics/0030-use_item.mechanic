name=use_item
commands=2
[route]
match routing::use_item::route(
    authority,
    session.actor,
    &mut session.admitted,
    command,
    &mut session.item_view,
    &mut session.container_views,
    &session.visibility,
)
.await
{
    Ok(dispatch) => dispatch,
    Err(path) => {
        routing::log_unresolved_use(command, path);
        return Err(command::disconnect(command, path, "use_route_unresolved"));
    }
}
