name=container_view
commands=21
[route]
match routing::container_view::route(
    authority,
    session.actor,
    &mut session.admitted,
    command,
    &mut session.container_views,
    &mut session.item_view,
)
.await
{
    Some(dispatch) => dispatch,
    None => return Err(ServeEnd::Disconnected),
}
