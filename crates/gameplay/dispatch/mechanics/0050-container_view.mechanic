name=container_view
commands=21
[route]
match routing::container_view::route(
    authority,
    session.actor,
    &mut session.admitted,
    command,
    &mut session.container_views,
    &mut session.item_view,
)
.await
{
    Some(dispatch) => dispatch,
    None => command_unavailable(command, "container_view_outcome_unavailable"),
}
