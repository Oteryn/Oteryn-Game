+                    .iter()
+                    .filter(|effect| matches!(effect, NpcRuleEffect::GiveItem { .. }))
+                    .count()
+                    > 1
+        }) {
+            return Err(NpcRuleError::MissingNativeResolution(
+                "inventory recipe effect".into(),
+            ));
+        }
+        Ok(plan)
