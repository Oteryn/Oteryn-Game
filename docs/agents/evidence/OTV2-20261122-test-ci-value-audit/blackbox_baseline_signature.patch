+
+    def test_current_baseline_preserves_all_recorded_signatures(self):
+        known = SOURCE.with_name('known_fail_rows.txt').read_text()
+        entries = [re.fullmatch(r'([^ ]+) ([a-z-]+) at ([^;\s]+)(?:;.*)?', line)
