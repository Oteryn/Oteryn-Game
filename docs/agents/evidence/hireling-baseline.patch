+fn run_case(case: Case) -> TestResult {
+    if std::env::var_os("OTERYN_TEST_POSTGRES_ADMIN_URL").is_none() { return Ok(()); }
+    std::thread::Builder::new().stack_size(256 << 20).spawn(move || {
+        run(async move |admin| {
+            let h = Harness::create_with_admission_seed(admin, "hireling_baseline", true, false).await?;
+            let result = scenario(&h, case).await;
+            h.cleanup().await?;
+            result?;
+            println!("HIRELING_BASELINE POSTGRES_CASE_COMPLETED");
+            Ok(())
+        }).map_err(|error| error.to_string())
+    })?.join().map_err(|_| "hireling baseline thread panicked")??;
+    Ok(())
+}
