+async fn exchange(owner: &ComposedFreshAdmission<'_, '_, '_>, admitted: &mut AdmittedSession, request: wire::Request) -> TestResult<(CommandStatus, Vec<u8>)> {
+    let body = request.encode();
+    let command = admitted.continuity.next_command_id;
+    let frame = encode_client_command(admitted.continuity.connection_generation, &ClientCommandValue { command_id: command, command_type: wire::COMMAND_TYPE_HIRELING, payload: &body }).map_err(debug)?;
+    let (mut server, mut client) = tokio::io::duplex(1 << 20);
+    client.write_all(&(frame.len() as u32).to_be_bytes()).await?;
+    client.write_all(&frame).await?;
+    client.shutdown().await?;
+    let end = serve_admitted(&mut server, *admitted, owner, IDLE_LIVENESS).await;
+    drop(server);
+    let mut output = Vec::new();
+    client.read_to_end(&mut output).await?;
+    if let ConnectionEnd::AdmittedThenDisconnected(current) | ConnectionEnd::AdmittedThenClosed(current, _) = &end { *admitted = *current; }
+    let mut cursor = 0;
+    while cursor < output.len() {
+        let n = u32::from_be_bytes(output[cursor..cursor+4].try_into()?) as usize;
+        let envelope = decode_wire_envelope(&output[cursor+4..cursor+4+n]).map_err(debug)?;
+        cursor += 4+n;
+        if envelope.message_type() == MessageType::CommandResult {
+            let result = decode_command_result(envelope.payload()).map_err(debug)?;
+            assert_eq!(result.command_id, command);
+            return Ok((result.status, result.payload.to_vec()));
+        }
+    }
+    Err(format!("hireling command {command} has no result: {end:?}").into())
+}
+async fn bank_case(
+    h: &Harness, owner: &ComposedFreshAdmission<'_, '_, '_>, admitted: &mut AdmittedSession,
+    actor: crate::foundation::ExactActorRef, x: u16, y: u16, floor: i8,
+) -> TestResult {
+    use crate::gameplay_transport::npc_talk::NpcTalkBook;
+    use oteryn_protocol_oteryn::world_spatial_entities::EntityRef;
+    use oteryn_simulation_determinism::SemanticTimeMicros;
+    use std::sync::Arc;
+    super::item_look::seed_main_backpack(h, &[("oteryn:item.tibia.i3031", 20)]).await?;
+    let key = format!("oteryn:npc.hireling-bank:{HOUSE}");
+    let npc = {
+        let mut runtime = owner.runtime.lock().await;
+        runtime.place_dynamic_npc(&key, crate::foundation::NpcPlacement {
+            x, y, floor, direction: crate::foundation::MovementFacing::South,
+        }).map_err(debug)?;
+        let placed = runtime.visible_entities().npcs.into_iter().find(|npc| runtime.npc_key(npc.actor) == Some(key.as_str())).ok_or("Hireling NPC")?;
+        EntityRef { identity: placed.actor.placement_identity(), generation: placed.generation }
+    };
+    owner.states.chat.install_npc_talk(Arc::new(NpcTalkBook::default()));
+    owner.states.chat.admit(admitted.game_session_id, "Fixture Hero", SemanticTimeMicros::from_micros(1));
+    owner.states.chat.set_npc_service(admitted.game_session_id);
+    for text in ["hi", "balance", "deposit 10", "yes"] {
+        let lines = bank_wire(owner, admitted, npc, text).await?;
+        if text == "balance" { assert!(lines.iter().any(|line| line == "Your account balance is 0 gold."), "bank balance reply: {lines:?}"); }
+    }
+    let deposit_command = admitted.continuity.next_command_id - 1;
+    bank_wire_command(owner, admitted, npc, "yes", deposit_command).await?;
+    let balance: i64 = sqlx::query_scalar("SELECT balance FROM game_account_bank_balances WHERE account_id=(SELECT account_id FROM game_character_roots WHERE character_id=encode($1,'hex')::uuid) AND world_id=encode($2,'hex')::uuid")
+        .bind(id(41).as_slice()).bind(id(42).as_slice()).fetch_one(&h.pool).await?;
+    assert_eq!(balance, 10);
+    // The real limiter window must expire; wait for its measured semantic deadline.
+    let deadline = owner.owner_now().get() + 1_000_000;
+    tokio::time::timeout(std::time::Duration::from_secs(3), async {
+        while owner.owner_now().get() < deadline {
+            tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+        }
+    }).await?;
+    for text in ["withdraw 5", "yes"] { bank_wire(owner, admitted, npc, text).await?; }
+    let balance: i64 = sqlx::query_scalar("SELECT balance FROM game_account_bank_balances WHERE account_id=(SELECT account_id FROM game_character_roots WHERE character_id=encode($1,'hex')::uuid) AND world_id=encode($2,'hex')::uuid")
+        .bind(id(41).as_slice()).bind(id(42).as_slice()).fetch_one(&h.pool).await?;
+    assert_eq!(balance, 5);
+    let operations: i64 = sqlx::query_scalar("SELECT count(*) FROM game_account_bank_operations WHERE acting_character_id=encode($1,'hex')::uuid")
+        .bind(id(41).as_slice()).fetch_one(&h.pool).await?;
+    assert_eq!(operations, 2);
+    let runtime = owner.runtime.lock().await;
+    let intent = oteryn_protocol_oteryn::npc_service::NpcTalkIntent { npc_actor: npc, text: "balance".into() };
+    assert!(owner.states.npc_conversations.current_bank(&owner.states.chat, &runtime, actor, admitted.game_session_id, &intent).is_some());
+    Ok(())
+}
