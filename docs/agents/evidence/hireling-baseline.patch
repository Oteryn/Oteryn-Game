+#[test]
+fn hireling_baseline_bank_greeting_resolves_current_bank_context() -> TestResult {
+    use crate::gameplay_transport::chat_intent::ChatRuntime;
+    use crate::gameplay_transport::npc_command::NpcConversations;
+    use crate::gameplay_transport::npc_talk::NpcTalkBook;
+    use oteryn_protocol_oteryn::npc_service::{NpcIntentDisposition, NpcTalkIntent};
+    use oteryn_protocol_oteryn::world_spatial_entities::EntityRef;
+    use oteryn_simulation_determinism::SemanticTimeMicros;
+    use std::sync::Arc;
+    let (mut runtime, actor, session) =
+        crate::gameplay_transport::actor_spell::tests::runtime_with_capacity(0x71, 3);
+    runtime.initialize_first_entry_position(actor).map_err(debug)?;
+    let position = runtime.read_actor_position(actor).map_err(debug)?.position();
+    let key = format!("oteryn:npc.hireling-bank:{HOUSE}");
+    runtime.place_dynamic_npc(&key, crate::foundation::NpcPlacement {
+        x: u16::try_from(position.x + 1)?, y: u16::try_from(position.y)?,
+        floor: -i8::try_from(position.floor)?, direction: crate::foundation::MovementFacing::South,
+    }).map_err(debug)?;
+    let npc = runtime.visible_entities().npcs[0];
+    let chat = ChatRuntime::default();
+    chat.admit(session, "Fixture Hero", SemanticTimeMicros::from_micros(1));
+    chat.set_npc_service(session);
+    chat.install_npc_talk(Arc::new(NpcTalkBook::default()));
+    let conversations = NpcConversations::default();
+    let greeting = NpcTalkIntent { npc_actor: EntityRef {
+        identity: npc.actor.placement_identity(), generation: npc.generation,
+    }, text: "hi".into() };
+    assert_eq!(conversations.talk_in(&chat, &runtime, actor, session, &greeting,
+        SemanticTimeMicros::from_micros(10), None).disposition, NpcIntentDisposition::Ok);
+    assert!(conversations.current_bank(&chat, &runtime, actor, session, &greeting).is_some(),
+        "the same dynamic Hireling accepted by greeting must resolve through the existing Bank owner");
+    Ok(())
+}
