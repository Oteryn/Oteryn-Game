+async fn bank_wire_command(
+    owner: &ComposedFreshAdmission<'_, '_, '_>, admitted: &mut AdmittedSession,
+    npc: oteryn_protocol_oteryn::world_spatial_entities::EntityRef, text: &str, command: u64,
+) -> TestResult<Vec<String>> {
+    use oteryn_protocol_oteryn::npc_service as npc_wire;
+    let expected_status = if command == admitted.continuity.next_command_id {
+        CommandStatus::Accepted
+    } else { CommandStatus::DuplicateReplay };
+    let body = npc_wire::encode_npc_talk_intent(&npc_wire::NpcTalkIntent { npc_actor: npc, text: text.into() }).map_err(debug)?;
+    let frame = encode_client_command(admitted.continuity.connection_generation, &ClientCommandValue {
+        command_id: command, command_type: npc_wire::COMMAND_TYPE_NPC_TALK_INTENT, payload: &body,
+    }).map_err(debug)?;
+    let (mut server, mut client) = tokio::io::duplex(1 << 20);
+    client.write_all(&(frame.len() as u32).to_be_bytes()).await?;
+    client.write_all(&frame).await?;
+    client.shutdown().await?;
+    let end = serve_admitted(&mut server, *admitted, owner, IDLE_LIVENESS).await;
+    drop(server);
+    let mut output = Vec::new(); client.read_to_end(&mut output).await?;
+    if let ConnectionEnd::AdmittedThenDisconnected(current) | ConnectionEnd::AdmittedThenClosed(current, _) = &end { *admitted = *current; }
+    let mut cursor = 0; let mut result = None; let mut lines = Vec::new();
+    while cursor < output.len() {
+        let n = u32::from_be_bytes(output[cursor..cursor+4].try_into()?) as usize;
+        let envelope = decode_wire_envelope(&output[cursor+4..cursor+4+n]).map_err(debug)?; cursor += 4+n;
+        if envelope.message_type() == MessageType::CommandResult {
+            let reply = decode_command_result(envelope.payload()).map_err(debug)?;
+            assert_eq!(reply.command_id, command); result = Some(reply.status);
+        } else if envelope.message_type() == MessageType::StateDelta {
+            let delta = oteryn_protocol_oteryn::decode_state_delta(envelope.payload()).map_err(debug)?;
+            if delta.domain_id == npc_wire::STATE_DOMAIN_NPC_CONVERSATION {
+                lines.extend(npc_wire::decode_npc_conversation(delta.payload).map_err(debug)?.lines);
+            }
+        }
+    }
+    assert_eq!(result, Some(expected_status), "NPC command {text}: {end:?}");
+    Ok(lines)
+}
