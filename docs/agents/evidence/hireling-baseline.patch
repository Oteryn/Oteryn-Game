+async fn bank_wire(
+    owner: &ComposedFreshAdmission<'_, '_, '_>, admitted: &mut AdmittedSession,
+    npc: oteryn_protocol_oteryn::world_spatial_entities::EntityRef, text: &str,
+) -> TestResult<Vec<String>> {
+    let command = admitted.continuity.next_command_id;
+    bank_wire_command(owner, admitted, npc, text, command).await
+}
