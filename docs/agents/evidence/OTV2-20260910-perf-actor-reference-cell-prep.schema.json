        "repository": {"const": "Oteryn/Oteryn-Game"}, "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "artifact_revision": {"type": "string", "minLength": 1}, "artifact_digest": {"$ref": "#/$defs/digest"},
        "lockfile_digest": {"$ref": "#/$defs/digest"}, "toolchain_identity": {"type": "string", "minLength": 1},
        "protocol_revision": {"type": "string", "minLength": 1}, "content_revision": {"type": "string", "minLength": 1},
        "world_revision": {"type": "string", "minLength": 1}, "ruleset_revision": {"type": "string", "minLength": 1},
        "sim_revision": {"type": "string", "minLength": 1}, "workload_revision": {"type": "string", "minLength": 1},
