{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Oteryn/Oteryn-Game/blob/main/docs/agents/evidence/OTV2-20260910-perf-actor-reference-cell-prep.schema.json",
  "title": "PERF-01 actor-carrier reference-cell evidence",
  "type": "object",
  "required": ["schema_version", "contract", "state", "candidate_M", "perf_01_status"],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {"const": "PERF-01-ACTOR-CARRIER-CELL-V1"},
    "state": {"enum": ["PLACEHOLDER_UNBOUND", "CELL_BOUND_NOT_MEASURED", "MEASUREMENT_INCOMPLETE", "MEASUREMENT_INVALID", "MEASUREMENT_COMPLETE_NOT_ACCEPTED"]},
    "candidate_M": {"type": ["integer", "null"], "minimum": 0},
    "perf_01_status": {"const": "OPEN"},
    "identities": {"$ref": "#/$defs/identities"},
    "comparison_baseline_identities": {"$ref": "#/$defs/identities"},
    "cell_fingerprint": {
      "type": "object", "required": ["expected", "observed"], "additionalProperties": false,
      "properties": {"expected": {"$ref": "#/$defs/fingerprint"}, "observed": {"$ref": "#/$defs/fingerprint"}}
    },
    "enforcement": {"$ref": "#/$defs/enforcement"},
    "objectives": {"$ref": "#/$defs/objectives"},
    "workload": {"$ref": "#/$defs/workload"},
    "populations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/population"}},
    "soak": {"type": "object"},
    "lower_coupled_limits": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}},
    "boundary": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "PLACEHOLDER_UNBOUND"}}, "required": ["state"]},
      "then": {"properties": {"candidate_M": {"type": "null"}}},
      "else": {"required": ["identities", "comparison_baseline_identities", "cell_fingerprint", "enforcement", "objectives", "workload", "populations", "soak", "lower_coupled_limits", "boundary"]}
    },
    {
      "if": {"properties": {"state": {"enum": ["CELL_BOUND_NOT_MEASURED", "MEASUREMENT_INCOMPLETE", "MEASUREMENT_INVALID"]}}, "required": ["state"]},
      "then": {"properties": {"candidate_M": {"type": "null"}}}
    }
  ],
  "$defs": {
