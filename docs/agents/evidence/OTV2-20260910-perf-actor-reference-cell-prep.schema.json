      "type": "object",
      "required": ["repository", "source_revision", "artifact_revision", "artifact_digest", "lockfile_digest", "toolchain_identity", "protocol_revision", "content_revision", "world_revision", "ruleset_revision", "sim_revision", "workload_revision", "capacity_evidence_source"],
