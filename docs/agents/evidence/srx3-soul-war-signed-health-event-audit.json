  "facts": [
    {
      "donor": "crystal",
      "path": "src/game/game.cpp",
      "lines": "7263-7285,7933-7948",
      "fact": "Ordinary damage is restored to a negative sign after block; creature health events run before absolute-value normalization."
    },
    {
      "donor": "crystal",
      "path": "src/lua/functions/lua_functions_loader.cpp",
      "lines": "598-607",
      "fact": "Raw signed primary and secondary values are pushed to Lua."
    },
    {
      "donor": "crystal",
      "path": "src/lua/creature/creatureevent.cpp",
      "lines": "468-483",
      "fact": "The raw push precedes the Lua call; absolute value and nonhealing negation happen only after Lua returns."
    },
    {
      "donor": "canary",
      "path": "src/game/game.cpp",
      "lines": "8463-8478",
      "fact": "The same health-event-before-absolute-value order applies."
    },
    {
      "donor": "canary",
      "path": "src/lua/functions/lua_functions_loader.cpp",
      "lines": "595-604",
      "fact": "The same raw signed push applies."
    },
    {
      "donor": "canary",
      "path": "src/lua/creature/creatureevent.cpp",
      "lines": "460-475",
      "fact": "The same postcallback absolute-value and negative-sign wrapper applies."
    },
    {
      "donor": "crystal",
      "path": "data-global/scripts/quests/soul_war/soul_war_mechanics.lua",
      "lines": "22-26,44-48,809-824",
      "fact": "Malice/Cage Lua reflection and Cloak blood require positive components; ordinary negative damage does not qualify."
    },
    {
      "donor": "crystal",
      "path": "src/game/game.cpp",
      "lines": "7827-7841,7933-7948",
      "fact": "Health-event arithmetic precedes Wheel for healing and damage; healing also precedes Monk improvement."
    },
    {
      "donor": "crystal",
      "path": "src/game/game.cpp",
      "lines": "7400-7401",
      "fact": "The damage-healing response invokes combatChangeHealth with a null attacker."
    },
    {
      "donor": "crystal",
      "path": "data/scripts/spells/healing/mass_healing.lua",
      "lines": "6-12",
      "fact": "Ordinary unmastered monsters are excluded unless present in the explicit eight-boss whitelist; Cloak is absent."
    },
    {
      "donor": "crystal",
      "path": "data/scripts/runes/ultimate_healing_rune.lua",
      "lines": "30-39",
      "fact": "Monsters are rejected; the additional player-self restriction follows."
    },
    {
      "donor": "crystal",
      "path": "data/scripts/spells/healing/heal_friend.lua",
      "lines": "86",
      "fact": "The registered named target uses hasPlayerNameParam(true)."
    },
    {
      "donor": "crystal",
      "path": "data/scripts/spells/healing/heal_monsters.lua",
      "lines": "12",
      "fact": "Monster healing uses caster ID0, which resolves to a null attacker."
    },
    {
      "donor": "crystal",
      "path": "data-global/monster/quests/soul_war/normal_monsters/furious_crater/cloak_of_terror.lua",
      "lines": "54,57",
      "fact": "Cloak is neither summonable nor convinceable."
    }
  ],
  "decisions": [
    "Do not change Lua predicates from positive to negative or absolute value as an implicit balance or intent repair.",
    "Keep native C++ reflection separate from these Lua callbacks.",
    "Normal Player damage must not emit Cloak positive-health blood.",
    "The positive-healing predicate remains literal; an allowed ordinary gameplay producer healing Cloak is not yet proved.",
    "Earlier tests assuming unsigned damage were incorrect contracts and are not source qualification evidence."
  ],
  "wiki": "wiki-pending"
