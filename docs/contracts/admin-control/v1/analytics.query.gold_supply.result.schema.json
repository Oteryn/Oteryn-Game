{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoldSupplyResult",
  "type": "object",
  "properties": {
    "completeness": {
      "$ref": "#/$defs/Completeness"
    },
    "context": {
      "$ref": "#/$defs/EconomyContext"
    },
    "filters": {
      "$ref": "#/$defs/GoldSupplyParams"
    },
    "metric_revision": {
      "type": "string"
    },
    "query_id": {
      "$ref": "#/$defs/GoldSupplyId"
    },
    "rows": {
      "$ref": "#/$defs/AnalyticsRows"
    },
    "watermark": {
      "$ref": "#/$defs/Watermark"
    }
  },
  "additionalProperties": false,
  "required": [
    "query_id",
    "filters",
    "metric_revision",
    "watermark",
    "completeness",
    "context",
    "rows"
  ],
  "$defs": {
    "AnalyticsRows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GoldSupplyRow"
      },
      "maxItems": 10000
    },
    "Completeness": {
      "type": "string",
      "enum": [
        "PROVEN_COMPLETE_FOR_DECLARED_DURABLE_SCOPE",
        "NO_KNOWN_GAP_BEST_EFFORT",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "Decimal": {
      "description": "Exact nonnegative amount or count, including values outside JSON's safe integer range.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "EconomyContext": {
      "type": "object",
      "properties": {
        "active_characters": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_revision": {
          "type": "string"
        },
        "ruleset_revision": {
          "type": "string"
        },
        "world_age_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "world_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "world_id",
        "world_age_days",
        "ruleset_revision",
        "content_revision"
      ]
    },
    "GoldSupplyFilters": {
      "type": "object",
      "additionalProperties": false
    },
    "GoldSupplyId": {
      "type": "string",
      "enum": [
        "gold_supply"
      ]
    },
    "GoldSupplyParams": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "grain": {
          "$ref": "#/$defs/Grain"
        },
        "params": {
          "$ref": "#/$defs/GoldSupplyFilters"
        },
        "query_id": {
          "$ref": "#/$defs/GoldSupplyId"
        },
        "to": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "query_id",
        "params",
        "from",
        "to",
        "grain"
      ]
    },
    "GoldSupplyRow": {
      "type": "object",
      "properties": {
        "bucket_start": {
          "type": "string"
        },
        "gold": {
          "$ref": "#/$defs/Decimal"
        }
      },
      "additionalProperties": false,
      "required": [
        "bucket_start",
        "gold"
      ]
    },
    "Grain": {
      "type": "string",
      "enum": [
        "minute",
        "hour",
        "day"
      ]
    },
    "Watermark": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
