{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NpcTradeFlowParams",
  "type": "object",
  "properties": {
    "from": {
      "type": "string"
    },
    "grain": {
      "$ref": "#/$defs/Grain"
    },
    "params": {
      "$ref": "#/$defs/NpcTradeFlowFilters"
    },
    "query_id": {
      "$ref": "#/$defs/NpcTradeFlowId"
    },
    "to": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "query_id",
    "params",
    "from",
    "to",
    "grain"
  ],
  "$defs": {
    "Grain": {
      "type": "string",
      "enum": [
        "minute",
        "hour",
        "day"
      ]
    },
    "NpcTradeFlowFilters": {
      "type": "object",
      "properties": {
        "item_type_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "npc_type_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "NpcTradeFlowId": {
      "type": "string",
      "enum": [
        "npc_trade_flow"
      ]
    }
  }
}
