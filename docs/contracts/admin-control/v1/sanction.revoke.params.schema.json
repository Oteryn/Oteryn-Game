{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RevokeParams",
  "type": "object",
  "properties": {
    "decision_revision": {
      "$ref": "#/$defs/DecisionRevision"
    },
    "operation_id": {
      "$ref": "#/$defs/EnforcementId"
    },
    "preview_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "prior_decision_revision": {
      "$ref": "#/$defs/DecisionRevision"
    },
    "profile": {
      "$ref": "#/$defs/BanProfile"
    },
    "sanction_stream_id": {
      "$ref": "#/$defs/EnforcementId"
    }
  },
  "additionalProperties": false,
  "required": [
    "operation_id",
    "sanction_stream_id",
    "decision_revision",
    "profile",
    "prior_decision_revision"
  ],
  "$defs": {
    "BanProfile": {
      "type": "string",
      "enum": [
        "ban_character",
        "ban_account"
      ]
    },
    "DecisionRevision": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "EnforcementId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
