{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlertsResult",
  "type": "object",
  "properties": {
    "alerts": {
      "$ref": "#/$defs/PageRows"
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "alerts"
  ],
  "$defs": {
    "Alert": {
      "type": "object",
      "properties": {
        "acknowledged_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "alert_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AlertKind"
        },
        "node_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "opened_at": {
          "type": "string"
        },
        "world_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "alert_id",
        "kind",
        "opened_at"
      ]
    },
    "AlertKind": {
      "type": "string",
      "enum": [
        "node_down",
        "lag",
        "disk",
        "backup_age",
        "error_spike"
      ]
    },
    "PageRows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Alert"
      },
      "maxItems": 100
    }
  }
}
