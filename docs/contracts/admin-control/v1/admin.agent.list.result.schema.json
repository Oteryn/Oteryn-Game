{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentPage",
  "type": "object",
  "properties": {
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Agent"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "agents"
  ],
  "$defs": {
    "Agent": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "build": {
          "type": "string"
        },
        "catalog_digest": {
          "type": "string"
        },
        "connected": {
          "type": "boolean"
        },
        "last_heartbeat": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "agent_id",
        "build",
        "catalog_digest",
        "last_heartbeat",
        "connected"
      ]
    }
  }
}
