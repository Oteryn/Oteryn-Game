{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalyticsQueryResult",
  "anyOf": [
    {
      "$ref": "#/$defs/GoldSourcesSinksResult"
    },
    {
      "$ref": "#/$defs/GoldSupplyResult"
    },
    {
      "$ref": "#/$defs/ItemSupplyByTypeResult"
    },
    {
      "$ref": "#/$defs/MarketPriceSeriesResult"
    },
    {
      "$ref": "#/$defs/MarketVolumeResult"
    },
    {
      "$ref": "#/$defs/NpcTradeFlowResult"
    },
    {
      "$ref": "#/$defs/TopWealthResult"
    }
  ],
  "$defs": {
    "AnalyticsRows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GoldFlowRow"
      },
      "maxItems": 10000
    },
    "AnalyticsRows2": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GoldSupplyRow"
      },
      "maxItems": 10000
    },
    "AnalyticsRows3": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ItemSupplyRow"
      },
      "maxItems": 10000
    },
    "AnalyticsRows4": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MarketPriceRow"
      },
      "maxItems": 10000
    },
    "AnalyticsRows5": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MarketVolumeRow"
      },
      "maxItems": 10000
    },
    "AnalyticsRows6": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NpcTradeRow"
      },
      "maxItems": 10000
    },
    "AnalyticsRows7": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WealthRow"
      },
      "maxItems": 10000
    },
    "Completeness": {
      "type": "string",
      "enum": [
        "PROVEN_COMPLETE_FOR_DECLARED_DURABLE_SCOPE",
        "NO_KNOWN_GAP_BEST_EFFORT",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "Decimal": {
      "description": "Exact nonnegative amount or count, including values outside JSON's safe integer range.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "EconomyContext": {
      "type": "object",
      "properties": {
        "active_characters": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_revision": {
          "type": "string"
        },
        "ruleset_revision": {
          "type": "string"
        },
        "world_age_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "world_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "world_id",
        "world_age_days",
        "ruleset_revision",
        "content_revision"
      ]
    },
    "GoldFlowRow": {
      "type": "object",
      "properties": {
        "bucket_start": {
          "type": "string"
        },
        "burned_gold": {
          "$ref": "#/$defs/Decimal"
        },
        "minted_gold": {
          "$ref": "#/$defs/Decimal"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "bucket_start",
        "source",
        "minted_gold",
        "burned_gold"
      ]
    },
    "GoldSourcesSinksFilters": {
      "type": "object",
      "properties": {
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "GoldSourcesSinksId": {
      "type": "string",
      "enum": [
        "gold_sources_sinks"
      ]
    },
    "GoldSourcesSinksParams": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "grain": {
          "$ref": "#/$defs/Grain"
        },
        "params": {
          "$ref": "#/$defs/GoldSourcesSinksFilters"
        },
        "query_id": {
          "$ref": "#/$defs/GoldSourcesSinksId"
        },
        "to": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "query_id",
        "params",
        "from",
        "to",
        "grain"
      ]
    },
    "GoldSourcesSinksResult": {
      "type": "object",
      "properties": {
        "completeness": {
          "$ref": "#/$defs/Completeness"
        },
        "context": {
          "$ref": "#/$defs/EconomyContext"
        },
        "filters": {
          "$ref": "#/$defs/GoldSourcesSinksParams"
        },
        "metric_revision": {
          "type": "string"
        },
        "query_id": {
          "$ref": "#/$defs/GoldSourcesSinksId"
        },
        "rows": {
          "$ref": "#/$defs/AnalyticsRows"
        },
        "watermark": {
          "$ref": "#/$defs/Watermark"
        }
      },
      "additionalProperties": false,
      "required": [
        "query_id",
        "filters",
        "metric_revision",
        "watermark",
        "completeness",
        "context",
        "rows"
      ]
    },
    "GoldSupplyFilters": {
      "type": "object",
