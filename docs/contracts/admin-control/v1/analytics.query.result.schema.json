        "query_id": {
          "$ref": "#/$defs/GoldSupplyId"
        },
        "to": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "query_id",
        "params",
        "from",
        "to",
        "grain"
      ]
    },
    "GoldSupplyResult": {
      "type": "object",
      "properties": {
        "completeness": {
          "$ref": "#/$defs/Completeness"
        },
        "context": {
          "$ref": "#/$defs/EconomyContext"
        },
        "filters": {
          "$ref": "#/$defs/GoldSupplyParams"
        },
        "metric_revision": {
          "type": "string"
        },
        "query_id": {
          "$ref": "#/$defs/GoldSupplyId"
