        "rows": {
          "$ref": "#/$defs/AnalyticsRows2"
        },
        "watermark": {
          "$ref": "#/$defs/Watermark"
        }
      },
      "additionalProperties": false,
      "required": [
        "query_id",
        "filters",
        "metric_revision",
        "watermark",
        "completeness",
        "context",
        "rows"
