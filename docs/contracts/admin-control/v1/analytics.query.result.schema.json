    "GoldSupplyId": {
      "type": "string",
      "enum": [
        "gold_supply"
      ]
    },
    "GoldSupplyParams": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "grain": {
          "$ref": "#/$defs/Grain"
        },
        "params": {
          "$ref": "#/$defs/GoldSupplyFilters"
