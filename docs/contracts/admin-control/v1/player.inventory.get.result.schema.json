{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inventory",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Item"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "$defs": {
    "Item": {
      "type": "object",
      "properties": {
        "count": {
          "type": "string"
        },
        "instance_id": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "type_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "instance_id",
        "type_id",
        "count",
        "location"
      ]
    }
  }
}
