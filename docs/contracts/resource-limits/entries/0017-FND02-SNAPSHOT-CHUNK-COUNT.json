{
  "id": "FND02-SNAPSHOT-CHUNK-COUNT",
  "owner_contract": "FND-02_PROTOCOL_OTERYN_V1_CONTRACT.md",
  "resource": "Chunks in one SnapshotBody transfer",
  "unit": "chunks",
  "hard_maximum": 256,
  "configurable_range": {
    "minimum": 256,
    "maximum": 256
