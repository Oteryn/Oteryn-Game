{
  "id": "PREY-DIFF-RL-REPLY",
  "owner_contract": "protocol-oteryn/v1/prey_v1.proto",
  "resource": "Prey reply transport bound",
  "unit": "encoded bytes per reply",
  "hard_maximum": 65536,
  "configurable_range": {
    "minimum": 65536,
    "maximum": 65536
  },
  "failure_category": "CAPACITY_EXCEEDED",
  "allocation_impact": "Bounded native Prey codec; list sizes remain server configuration (9/12 by default).",
  "client_visible": true,
  "boundary_tests": [
    "reply_rejects_oversize_counts_order_and_timestamp_overflow"
  ],
  "consumers": [
    "crates/protocol-oteryn/src/prey.rs MAX_REPLY_BYTES"
  ],
  "notes": "OWNER-DEVIATION PREY-DIFF 2026-11-01; extends capability140/command160 without adding a new capability."
}
