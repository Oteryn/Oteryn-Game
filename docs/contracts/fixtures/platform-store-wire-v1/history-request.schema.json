{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oteryn.invalid/schemas/oteryn.store_wire.history_request.v1.json",
  "title": "oteryn.store_wire.history_request.v1",
  "description": "Request body of POST /internal/v1/products-entitlements/store/history/read (ReadStoreHistoryPageV1). At most 512 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation",
    "source_authority",
    "account_id",
    "before_entry_id",
    "max_entries"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "operation": {
      "const": "ReadStoreHistoryPageV1"
    },
    "source_authority": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
    },
    "account_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "before_entry_id": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "max_entries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    }
  }
}
