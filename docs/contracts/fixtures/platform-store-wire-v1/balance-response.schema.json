{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oteryn.invalid/schemas/oteryn.store_wire.balance_response.v1.json",
  "title": "oteryn.store_wire.balance_response.v1",
  "description": "200 body of ReadStoreBalanceV1. At most 512 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "result",
    "account_id",
    "balances",
    "read_at"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "result": {
      "const": "OK"
    },
    "account_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "balances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currency",
          "available",
          "reserved"
        ],
        "properties": {
          "currency": {
            "enum": [
              "COINS",
              "TRANSFERABLE_COINS"
            ]
          },
          "available": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$"
          },
          "reserved": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$"
          }
        }
      }
    },
    "read_at": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    }
  }
}
