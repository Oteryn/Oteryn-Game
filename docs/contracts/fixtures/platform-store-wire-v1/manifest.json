  "cross_field_rules": [
    "uint64 strings are at most 18446744073709551615; amount strings are at most 9223372036854775807",
    "a cursor pair is either (\"0\", nil UUID) or (a uint64 revision, a UUIDv7)",
    "purchase answer request_digest = sha256 of the exact purchase request bytes; purchase_request_id equals the request value",
    "ACCEPTED: total_price = quantity x unit_price of the request, currency equals the request currency, units has one entry per fulfilment unit",
    "receipt binding_digest = sha256 of the exact stored intent bytes served by ReadStoreOperationIntentV1",
    "receipt operation_kind, operation_id, account_id, entitlement_id, product_id and product_version equal the intent",
    "DELIVER delivered_quantity, CLAIM minted_quantity and REVOKE_UNCLAIMED revoked_quantity equal the intent or line quantity",
    "RECLAIM reclaimed_quantity + shortfall_quantity = minted_quantity of the claim receipt named by claim_receipt_digest; STORE_RECLAIMED iff shortfall_quantity is 0",
    "RECLAIM claim_receipt_digest = sha256 of the stored CLAIM receipt bytes",
    "reconcile: state PENDING or REOPENED iff receipt_digest and recovery_generation are null",
    "history: order_id, offer_key and quantity are non-null iff kind is STORE_PURCHASE or STORE_REVERSAL",
    "history entries are strictly descending by entry_id and below before_entry_id unless it is \"0\"; next_before_entry_id is the last entry_id, or \"0\" when no older entry exists",
    "pending and reconcile entries are strictly ascending by (source_revision numerically, operation_id) and above the request cursor",
    "restore notice new_recovery_generation > restored_generation",
    "serialized canonical body is within its max_*_bytes bound"
  ],
