{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oteryn.invalid/schemas/oteryn.store_wire.restore_notice.v1.json",
  "title": "oteryn.store_wire.restore_notice.v1",
  "description": "Existing PublishGameRestoreNoticeV1 body (oteryn-v2-game-restore-reconciliation-v1) at POST /internal/v1/game-auth/game-restore/notice, reused unchanged; at most 512 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation",
    "source_authority",
    "restore_event_id",
    "restored_generation",
    "new_recovery_generation",
    "restore_point",
    "backup_label"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "operation": {
      "const": "PublishGameRestoreNoticeV1"
    },
    "source_authority": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
    },
    "restore_event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "restored_generation": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "new_recovery_generation": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "restore_point": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "backup_label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    }
  }
}
