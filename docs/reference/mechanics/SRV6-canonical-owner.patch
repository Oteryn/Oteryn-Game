+#[cfg(test)]
+mod srv6_conversion_tests {
+    use super::*;
+    #[test]
+    #[allow(clippy::unwrap_used, reason="literal source-owner fixture identities")]
+    fn srv6_legacy_discovery_is_only_its_mapped_main_area() {
+        let mut progress=CanonicalProgress {legacy:MapProgress {discovered:true,exploration:None},subareas:BTreeMap::new()};
+        let mut request=MapRequest {
+            command:crate::foundation::CommandRef::new(crate::foundation::GameSessionId::decode(&[1,1,1,1,1,1,0x71,1,0x81,1,1,1,1,1,1,1]).unwrap(),crate::foundation::CommandId::new(1).unwrap()),
+            action:MapAction::Query,binding:[0;32],occurrence:[0;16],bundle:[0;32],epoch:0,
+            area:2,legacy_area:1,subarea:Some(21),subareas:vec![(1,11),(1,12),(2,21),(2,22)],
+            pool:Vec::new(),at:Point{x:0,y:0,floor:0},fee:None,transaction:[0;16],event:[0;16],now:1
+        };
+        progress.convert(&request);
+        assert!(progress.subareas[&11].discovered);
+        assert!(progress.subareas[&12].discovered);
+        assert!(!progress.subareas[&21].discovered);
+        assert!(!progress.subareas[&22].discovered);
+        request.area=1; request.subarea=Some(11);
+        progress.convert(&request);
+        assert!(!progress.subareas[&21].discovered,"visiting another area must not import discovery");
+    }
+}
