      "resolution": "Native source qualification: {\"family_module\": \"native_combat\", \"observations\": {\"accepted_reference_evidence\": [{\"authority\": \"AcceptedAuthoringReference\", \"path\": \"tools/content-schema/spell-authoring/wheel-augments.json\", \"sha256\": \"fc1680a45bf0d28a71b7f16b700146a4e804119f39a771cf9cf8af93addf673c\", \"target_date\": \"2026-09-27\"}, {\"authority\": \"AcceptedAuthoringReference\", \"path\": \"tools/content-schema/spell-authoring/official-changes.json\", \"sha256\": \"76338a738f8d08aaa809e718b7761415fa436c6f449bacd3c21200a09b5971d1\", \"target_date\": \"2026-09-27\"}], \"attributed_conflicts\": [{\"alternative\": \"both pinned OTS callbacks6 =>7total\", \"authority\": \"Fandom Updates15.25, native chain candidate\", \"field\": \"further_targets\", \"selected\": 3}, {\"alternative\": \"both pinned OTS explicit12000\", \"authority\": \"Fandom Chivalrous Challenge\", \"field\": \"challenge_ms\", \"selected\": 6000}, {\"alternative\": \"pinned OTS nearest-only picker\", \"authority\": \"official15.01.4b0877 native chain candidate\", \"field\": \"first_target\", \"selected\": \"attacked valid target before nearest fallback\"}], \"authoring_complete\": true, \"formula_reference_evidence\": [], \"runtime_admission\": \"rejected_until_native_contract_and_owner_integration\", \"selection_rule\": \"S24 official/wiki accepted target-date facts; S21 pinned Canary fallback hypotheses; S5 level normalization\", \"source_evidence\": [{\"authority\": \"OtsHypothesisOnly\", \"blob\": \"eb85056b26c785123c6d53b26151390a7751741f\", \"path\": \"data/scripts/spells/support/chivalrous_challenge.lua\", \"revision\": \"99902524e052f37574194466c2949c576e4ab269\", \"sha256\": \"8f5dd04e0f045cedd0a30b993c154a8e7cc4b8d1d774547de188a92184c8aa41\", \"source\": \"canary\"}, {\"authority\": \"OtsHypothesisOnly\", \"blob\": \"1ca23f267d075c70d0e1954c204c0b3be1f8c655\", \"path\": \"data/scripts/spells/support/chivalrous_challenge.lua\", \"revision\": \"ff7ede5