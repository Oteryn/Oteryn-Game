//! Capability 16 joins the existing offer sets after journal composition.

use super::*;

#[test]
fn the_production_set_selects_only_offered_capabilities_whatever_the_client_supports()
-> Result<(), Box<dyn Error>> {
    let mut everything: Vec<u32> = Vec::new();
    for capability in registry_capabilities()? {
        everything.push(u32::try_from(capability["id"].as_u64().ok_or("id")?)?);
    }
    everything.extend([
        2,  // reserved capability
        3,  // NPC_SERVICE_V1
        4,  // ITEM_VIEW_MOVE_V1
        5,  // unregistered capability
        9,  // HIGHSCORES_V1
        11, // WORLD_INTERACTION_V1
        12, // ITEM_EQUIP_DROP_V1
        13, // PACED_MOVEMENT_V1
        14, // CONTAINER_TREE_V1
    ]);
    everything.sort_unstable();
    everything.dedup();
    let production_expected = fragment_offer_ids("production")?;
    assert_eq!(
        SelectedCapabilities::select(PRODUCTION_OFFERED_CAPABILITIES, &everything)
            .as_ref()
            .map(SelectedCapabilities::as_slice),
<<<<<<< /home/mole/oteryn-cache/rs-wt/capsplit3/.caps-split-work/current
        Some(&[6, 7, 9, 13, 16, 17, 19, 21, 26, 31, 36, 40, 49][..])
=======
        Some(&production_expected[..])
>>>>>>> /home/mole/oteryn-cache/rs-wt/capsplit3/.caps-split-work/desired
    );
    // MAP-ITEM-REF-1: the not-yet-offered Item view set adds 4, which requires 6.
    let item_view_expected = fragment_offer_ids("item_view")?;
    assert_eq!(
        SelectedCapabilities::select(ITEM_VIEW_OFFERED_CAPABILITIES, &everything)
            .as_ref()
            .map(SelectedCapabilities::as_slice),
<<<<<<< /home/mole/oteryn-cache/rs-wt/capsplit3/.caps-split-work/current
        Some(&[4, 6, 7, 9, 13, 16, 17, 19, 21, 26, 31, 36, 40, 49][..])
=======
        Some(&item_view_expected[..])
>>>>>>> /home/mole/oteryn-cache/rs-wt/capsplit3/.caps-split-work/desired
    );
    assert_eq!(
        SelectedCapabilities::select(
            ITEM_VIEW_OFFERED_CAPABILITIES,
            &[
                4,  // ITEM_VIEW_MOVE_V1
                13, // PACED_MOVEMENT_V1
            ]
        )
        .as_ref()
        .map(SelectedCapabilities::as_slice),
        Some(&[13][..])
    );
    Ok(())
}
