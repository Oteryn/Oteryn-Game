          "line": 232,
          "text": "local function playerAddContainerItem(params, item)",
          "line_sha256": "dfdd8a9ef428367ccc2a567ded38267d404afad5a4c132eb27d344567501d58b"
        },
        {
          "line": 233,
          "text": "\tlocal player = params.player",
          "line_sha256": "6a2419b2827506594347659c41c6896d007083e15a65187869586961a53b6532"
        },
        {
          "line": 234,
          "text": "\tlocal reward = params.containerReward",
          "line_sha256": "c95f98076b3f16061fd8475bc58799402edc2133e9bc3bd550a3c34b4670e097"
        },
        {
          "line": 235,
          "text": "\tlocal attribute = AttributeTable[item.uid]",
          "line_sha256": "31ef3b48a786a3fe532f8f46e315548a5c0fde75d820a21f1073065ba98c88e4"
        },
        {
          "line": 236,
          "text": "\tlocal achievement = achievementTable[item.uid]",
          "line_sha256": "66dfa47a6d866f232d20ae036735ad85c9e849ad389319f8c31239849ba8b7b3"
        },
        {
          "line": 237,
          "text": "\tfor i = 1, #params.items do",
          "line_sha256": "01908b4d95cbab4473adce3f2e9560dac699be44967da873fc683c4cf0c35d57"
        },
        {
          "line": 238,
          "text": "\t\tlocal rewardEntry = params.items[i]",
          "line_sha256": "04ae532971cfba326b3c8a642e0a65f6f36765ef2f7c690667447332f3c131d7"
        },
        {
          "line": 239,
          "text": "\t\tlocal itemid = rewardEntry[1]",
          "line_sha256": "e75649463833b47f308c1f7a8301fd64165aafa034919e03d5f53531f2534235"
        },
        {
          "line": 240,
          "text": "\t\tlocal count = rewardEntry[2]",
          "line_sha256": "9cc267a1273a3598be3ab4c7ce9b447d9994db57416a2ac17f0ba67777982da4"
        },
        {
          "line": 241,
          "text": "\t\tlocal addedItem = reward:addItem(itemid, count)",
          "line_sha256": "38c19fd1d29757efbbefd1a508f44a853474295f41ed1d5d060a57626a58916c"
        },
        {
          "line": 242,
          "text": "\t\tif addedItem and ItemType(itemid):isKey() and params.action then",
          "line_sha256": "cf0926ae3438159e6eede17e6038ae14074f85b8ab519db0a0b76a6dd54aabe4"
        },
        {
          "line": 243,
          "text": "\t\t\taddedItem:setActionId(params.action)",
