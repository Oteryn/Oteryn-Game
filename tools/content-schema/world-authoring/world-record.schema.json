{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oteryn.dev/schemas/content/world-record/v1",
  "title": "Oteryn World record authoring files v1 (World)",
  "description": "Family index and the single shard of the World family: identity, coordinate frame, the half-open horizontal bounds (OTERYN_WORLD_SPATIAL_COORDINATE_PROFILE_V1) and the strictly increasing declared floor ids. Derived from the committed WorldPlacement.Base region files.",
  "oneOf": [
    {
      "$ref": "#/$defs/family_index"
    },
    {
      "$ref": "#/$defs/world_shard"
    }
  ],
  "$defs": {
    "coordinate_frame": {
      "const": "global-target-2026-09-27"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "i32": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "i64_bound": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483648
    },
    "floor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "revision"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^oteryn:world\\.[a-z0-9]+(_[a-z0-9]+)*$",
          "maxLength": 128
        },
        "revision": {
          "const": "definition-r1"
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_x_exclusive",
        "max_y_exclusive",
        "min_x",
        "min_y"
      ],
      "properties": {
        "min_x": {
          "$ref": "#/$defs/i32"
        },
        "min_y": {
          "$ref": "#/$defs/i32"
        },
        "max_x_exclusive": {
          "$ref": "#/$defs/i64_bound"
        },
        "max_y_exclusive": {
          "$ref": "#/$defs/i64_bound"
        }
      }
    },
    "source_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "height",
        "otbm_version",
        "width"
      ],
      "properties": {
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "otbm_version": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "world_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration",
        "source_bindings"
      ],
      "properties": {
        "declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bounds",
            "coordinate_frame",
            "floors",
            "identity",
            "kind",
            "legacy_world_id",
            "name",
            "source_map"
          ],
          "properties": {
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "coordinate_frame": {
              "$ref": "#/$defs/coordinate_frame"
            },
            "floors": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/floor"
              }
            },
            "identity": {
              "$ref": "#/$defs/identity"
            },
            "kind": {
              "const": "World"
            },
            "legacy_world_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "source_map": {
              "$ref": "#/$defs/source_map"
            }
          }
        },
        "source_bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "disposition",
              "external_id",
              "identity_namespace",
              "source_key",
              "source_revision",
              "target"
            ],
            "properties": {
              "disposition": {
                "const": "EXACT"
              },
              "external_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "identity_namespace": {
                "const": "crystalserver/world-map"
              },
              "source_key": {
                "const": "oteryn:source.crystalserver"
              },
              "source_revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "family",
                  "key",
                  "revision"
                ],
                "properties": {
                  "family": {
                    "const": "World"
                  },
                  "key": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "revision": {
                    "const": "definition-r1"
                  }
                }
              }
            }
          }
        }
      }
    },
    "world_shard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "records",
        "schema",
        "shard"
      ],
      "properties": {
        "family": {
          "const": "World"
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/world_record"
          }
        },
        "schema": {
          "const": "OTERYN_WORLD_AUTHORING_SHARD/v1"
        },
        "shard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "end",
            "index",
            "start"
          ],
          "properties": {
            "count": {
              "const": 1
            },
            "end": {
              "const": 0
            },
            "index": {
              "const": 0
            },
            "start": {
              "const": 0
            }
          }
        }
      }
    },
    "family_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_frame",
        "family",
        "generator",
        "population_state",
        "record_count",
        "schema",
        "shard_size",
        "shards",
        "source"
      ],
      "properties": {
        "coordinate_frame": {
          "$ref": "#/$defs/coordinate_frame"
        },
        "family": {
          "const": "World"
        },
        "generator": {
          "const": "tools/content-schema/world-authoring/convert_world_record.py"
        },
        "population_state": {
          "const": "POPULATED"
        },
        "record_count": {
          "const": 1
        },
        "schema": {
          "const": "OTERYN_FAMILY_INDEX/v1"
        },
        "shard_size": {
          "const": 500
        },
        "shards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "content/world/worlds/worlds-00000-00000.json"
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence",
            "files",
            "ref",
            "repository",
            "revision",
            "source_key"
          ],
          "properties": {
            "evidence": {
              "const": "OtsHypothesisOnly"
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "const": "data-global/world/world.otbm"
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "const": "zimbadev/crystalserver"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "source_key": {
              "const": "oteryn:source.crystalserver"
            }
          }
        }
      }
    }
  }
}
