{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oteryn.dev/schemas/content/world-metadata/v1",
  "title": "Oteryn world metadata authoring files v1 (City, HuntingPlace and Region Area, teleport Transition)",
  "description": "Family index and shard files for world metadata. Static source facts only. Houses are owned by the House catalogue (content/houses/, OTERYN_HOUSE_CATALOGUE_OWNER_CONTRACT_V1). Terrain, objects and placements are out of scope.",
  "oneOf": [
    { "$ref": "#/$defs/family_index" },
    { "$ref": "#/$defs/city_shard" },
    { "$ref": "#/$defs/hunting_place_shard" },
    { "$ref": "#/$defs/region_shard" },
    { "$ref": "#/$defs/transition_shard" }
  ],
  "$defs": {
    "slug_key": {
      "type": "string",
      "maxLength": 128
    },
    "u16": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "floor": { "type": "integer", "minimum": 0, "maximum": 15 },
    "level": { "type": "integer", "minimum": 1, "maximum": 5000 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "coordinate_frame": { "const": "global-target-2026-09-27" },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate_frame", "floor", "x", "y"],
      "properties": {
        "coordinate_frame": { "$ref": "#/$defs/coordinate_frame" },
        "floor": { "$ref": "#/$defs/floor" },
        "x": { "$ref": "#/$defs/u16" },
        "y": { "$ref": "#/$defs/u16" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "revision"],
      "properties": {
        "key": { "$ref": "#/$defs/slug_key" },
        "revision": { "const": "definition-r1" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "key", "revision"],
      "properties": {
        "family": { "enum": ["Area", "Item", "NPC", "Transition"] },
        "key": { "$ref": "#/$defs/slug_key" },
        "revision": { "const": "definition-r1" }
      }
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "external_id", "identity_namespace", "source_key", "source_revision", "target"],
      "properties": {
        "disposition": { "const": "EXACT" },
        "external_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "identity_namespace": {
          "enum": ["crystalserver/town-id", "crystalserver/map-item-position"]
        },
        "source_key": { "const": "oteryn:source.crystalserver" },
        "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "target": { "$ref": "#/$defs/reference" }
      }
    },
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/source_binding" }
    },
    "wiki_source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition", "external_id", "identity_namespace", "source_key", "source_revision", "target"
      ],
      "properties": {
        "disposition": { "const": "EXACT" },
        "external_id": { "type": "string", "pattern": "^[1-9][0-9]{0,11}$" },
        "identity_namespace": { "const": "tibiawiki-fandom/page-id" },
        "source_key": { "const": "oteryn:source.tibiawiki" },
        "source_revision": { "type": "string", "pattern": "^[1-9][0-9]{0,11}$" },
        "target": { "$ref": "#/$defs/reference" }
      }
    },
    "client_source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition", "external_id", "identity_namespace", "source_key", "source_revision", "target"
      ],
      "properties": {
        "disposition": { "const": "EXACT" },
        "external_id": { "type": "string", "pattern": "^[1-9][0-9]{0,5}$" },
        "identity_namespace": { "const": "tibia-client/map-area-id" },
        "source_key": { "const": "oteryn:source.tibia_client" },
        "source_revision": { "$ref": "#/$defs/sha256" },
        "target": { "$ref": "#/$defs/reference" }
      }
    },
    "area_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/reference" },
          { "properties": { "family": { "const": "Area" } } }
        ]
      }
    },
    "region_footprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_frame", "floor", "image", "max_x", "max_y", "min_x", "min_y", "tile_count"
      ],
      "properties": {
        "coordinate_frame": { "$ref": "#/$defs/coordinate_frame" },
        "floor": { "$ref": "#/$defs/floor" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^content/assets/files/subarea-[0-9]{4}-[0-9a-f]{64}\\.bmp\\.lzma$"
            },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "max_x": { "$ref": "#/$defs/u16" },
        "max_y": { "$ref": "#/$defs/u16" },
        "min_x": { "$ref": "#/$defs/u16" },
        "min_y": { "$ref": "#/$defs/u16" },
        "tile_count": { "type": "integer", "minimum": 1 }
      }
    },
    "region_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration", "source_bindings"],
      "properties": {
        "declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["area_kind", "identity", "kind", "name"],
          "properties": {
            "anchor": { "$ref": "#/$defs/position" },
            "area_kind": { "enum": ["region", "subregion"] },
            "cities": { "$ref": "#/$defs/area_references" },
            "footprint": { "$ref": "#/$defs/region_footprint" },
            "identity": {
              "allOf": [
                { "$ref": "#/$defs/identity" },
                { "properties": { "key": { "pattern": "^oteryn:area\\.region\\.[a-z0-9]+(_[a-z0-9]+)*$" } } }
              ]
            },
            "kind": { "const": "Area" },
            "name": { "type": "string", "minLength": 1, "maxLength": 64 },
            "parent_regions": { "$ref": "#/$defs/area_references" }
          },
          "allOf": [
            {
              "if": { "properties": { "area_kind": { "const": "region" } } },
              "then": { "not": { "anyOf": [{ "required": ["parent_regions"] }, { "required": ["footprint"] }] } },
              "else": { "required": ["parent_regions"] }
            }
          ]
        },
        "source_bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/client_source_binding" }
        }
      }
    },
    "hunting_place_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration", "source_bindings"],
      "properties": {
        "declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["area_kind", "identity", "kind", "name"],
          "properties": {
            "area_kind": { "const": "hunting_place" },
            "city": {
              "allOf": [
                { "$ref": "#/$defs/reference" },
                { "properties": { "family": { "const": "Area" } } }
              ]
            },
            "identity": {
              "allOf": [
                { "$ref": "#/$defs/identity" },
                { "properties": { "key": { "pattern": "^oteryn:area\\.hunting_place\\.[a-z0-9]+(_[a-z0-9]+)*$" } } }
              ]
            },
            "kind": { "const": "Area" },
            "name": { "type": "string", "minLength": 1, "maxLength": 64 },
            "position": { "$ref": "#/$defs/position" },
            "recommended_levels": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "knight": { "$ref": "#/$defs/level" },
                "mage": { "$ref": "#/$defs/level" },
                "paladin": { "$ref": "#/$defs/level" }
              }
            },
            "source_facts": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "city_name": { "type": "string", "minLength": 1, "maxLength": 64 },
                "creature_names": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 '().,:&!/-]{0,63}$" }
                }
              }
            }
          }
        },
        "source_bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/wiki_source_binding" }
        }
      }
    },
    "city_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration", "source_bindings"],
      "properties": {
        "declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["area_kind", "identity", "kind", "name", "temple"],
          "properties": {
            "area_kind": { "const": "city" },
            "identity": {
              "allOf": [
                { "$ref": "#/$defs/identity" },
                { "properties": { "key": { "pattern": "^oteryn:area\\.city\\.[a-z0-9]+(_[a-z0-9]+)*$" } } }
              ]
            },
            "kind": { "const": "Area" },
            "implemented": { "type": "string", "pattern": "^(Pre-)?[0-9]{1,2}\\.[0-9]{1,3}(\\.[0-9]{1,6})?$" },
            "name": { "type": "string", "minLength": 1, "maxLength": 64 },
            "npcs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/reference" },
                  {
                    "properties": {
                      "family": { "const": "NPC" },
                      "key": { "pattern": "^oteryn:npc\\.[a-z0-9]+(_[a-z0-9]+)*$" }
                    }
                  }
                ]
              }
            },
            "source_facts": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "implemented": { "type": "string", "minLength": 1, "maxLength": 32 },
                "near": { "type": "string", "minLength": 1, "maxLength": 512 },
                "npc_names_unmatched": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^\\S(.{0,62}\\S)?$" }
                },
                "ruler": { "type": "string", "minLength": 1, "maxLength": 256 }
              }
            },
            "temple": { "$ref": "#/$defs/position" }
          }
        },
        "source_bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "prefixItems": [{ "$ref": "#/$defs/source_binding" }],
          "items": { "$ref": "#/$defs/wiki_source_binding" }
        }
      }
    },
    "transition_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration", "source_bindings"],
      "properties": {
        "declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "identity", "kind", "to", "transition_kind"],
          "properties": {
            "from": { "$ref": "#/$defs/position" },
            "identity": {
              "allOf": [
                { "$ref": "#/$defs/identity" },
                { "properties": { "key": { "pattern": "^oteryn:transition\\.teleport\\.x[0-9]+_y[0-9]+_z[0-9]+(_[0-9]+)?$" } } }
              ]
            },
            "kind": { "const": "Transition" },
            "object": {
              "allOf": [
                { "$ref": "#/$defs/reference" },
                { "properties": { "family": { "const": "Item" } } }
              ]
            },
            "to": { "$ref": "#/$defs/position" },
            "transition_kind": { "const": "teleport" }
          }
        },
        "source_bindings": { "$ref": "#/$defs/source_bindings" }
      }
    },
    "shard_header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "end", "index", "start"],
      "properties": {
        "count": { "type": "integer", "minimum": 1, "maximum": 500 },
        "end": { "type": "integer", "minimum": 0 },
        "index": { "type": "integer", "minimum": 0 },
        "start": { "type": "integer", "minimum": 0 }
      }
    },
    "city_shard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "records", "schema", "shard"],
      "properties": {
        "family": { "const": "Area.City" },
        "records": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/city_record" } },
        "schema": { "const": "OTERYN_AREA_AUTHORING_SHARD/v1" },
        "shard": { "$ref": "#/$defs/shard_header" }
      }
    },
    "hunting_place_shard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "records", "schema", "shard"],
      "properties": {
        "family": { "const": "Area.HuntingPlace" },
        "records": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/hunting_place_record" } },
        "schema": { "const": "OTERYN_AREA_AUTHORING_SHARD/v1" },
        "shard": { "$ref": "#/$defs/shard_header" }
      }
    },
    "region_shard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "records", "schema", "shard"],
      "properties": {
        "family": { "const": "Area.Region" },
        "records": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/region_record" } },
        "schema": { "const": "OTERYN_AREA_AUTHORING_SHARD/v1" },
        "shard": { "$ref": "#/$defs/shard_header" }
      }
    },
    "transition_shard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "records", "schema", "shard"],
      "properties": {
        "family": { "const": "Transition.Teleport" },
        "records": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/transition_record" } },
        "schema": { "const": "OTERYN_TRANSITION_AUTHORING_SHARD/v1" },
        "shard": { "$ref": "#/$defs/shard_header" }
      }
    },
    "family_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_frame", "family", "generator", "population_state", "record_count", "schema",
        "shard_size", "shards", "source"
      ],
      "properties": {
        "coordinate_frame": { "$ref": "#/$defs/coordinate_frame" },
        "enrichment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence", "fetched_at", "generator", "license", "site", "snapshot", "source_key"],
          "properties": {
            "evidence": { "const": "Derived" },
            "fetched_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "generator": { "const": "tools/content-schema/world-authoring/convert_city_facts.py" },
            "license": { "type": "string", "minLength": 1, "maxLength": 512 },
            "site": { "const": "https://tibia.fandom.com" },
            "snapshot": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "const": "imports/tibiawiki/cities/fandom-snapshot-v1.json" },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            },
            "source_key": { "const": "oteryn:source.tibiawiki" }
          }
        },
        "family": { "enum": ["Area.City", "Area.HuntingPlace", "Area.Region", "Transition.Teleport"] },
        "generator": {
          "enum": [
            "tools/content-schema/world-authoring/convert_world_metadata.py",
            "tools/content-schema/world-authoring/convert_hunting_places.py",
            "tools/content-schema/world-authoring/convert_map_regions.py"
          ]
        },
        "population_state": { "const": "POPULATED" },
        "record_count": { "type": "integer", "minimum": 1 },
        "schema": { "const": "OTERYN_FAMILY_INDEX/v1" },
        "shard_size": { "const": 500 },
        "shards": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^content/[a-z/-]+/[a-z-]+-[0-9]{5}-[0-9]{5}\\.json$" }
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence", "files", "ref", "repository", "revision", "source_key"],
              "properties": {
                "evidence": { "const": "OtsHypothesisOnly" },
                "files": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "sha256"],
                    "properties": {
                      "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
                      "sha256": { "$ref": "#/$defs/sha256" }
                    }
                  }
                },
                "ref": { "type": "string", "minLength": 1 },
                "repository": { "const": "zimbadev/crystalserver" },
                "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                "source_key": { "const": "oteryn:source.crystalserver" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["category", "evidence", "fetched_at", "license", "site", "snapshot", "source_key"],
              "properties": {
                "category": { "const": "Category:Hunting Places" },
                "evidence": { "const": "Derived" },
                "fetched_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                "license": { "type": "string", "minLength": 1, "maxLength": 512 },
                "site": { "const": "https://tibia.fandom.com" },
                "snapshot": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "sha256"],
                  "properties": {
                    "path": { "const": "imports/tibiawiki/hunting-places/fandom-snapshot-v1.json" },
                    "sha256": { "$ref": "#/$defs/sha256" }
                  }
                },
                "source_key": { "const": "oteryn:source.tibiawiki" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["client_version", "evidence", "files", "manifest", "source_key"],
              "properties": {
                "client_version": { "const": "15.30" },
                "evidence": { "const": "OfficialClient" },
                "files": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "sha256"],
                    "properties": {
                      "path": { "type": "string", "pattern": "^content/assets/files/map-[0-9a-f]{64}\\.dat$" },
                      "sha256": { "$ref": "#/$defs/sha256" }
                    }
                  }
                },
                "manifest": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["archive_sha256", "path"],
                  "properties": {
                    "archive_sha256": { "$ref": "#/$defs/sha256" },
                    "path": { "const": "imports/official/client-assets/15.30/manifest.json" }
                  }
                },
                "source_key": { "const": "oteryn:source.tibia_client" }
              }
            }
          ]
        }
      }
    }
  }
}
