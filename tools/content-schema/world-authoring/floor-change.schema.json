{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oteryn.dev/schemas/content/floor-change/v1",
  "title": "Oteryn floor-change object authoring files v1 (WorldObject.FloorChange)",
  "description": "Family index, shard and capture summary of the floor-change item types (stairs, ramps, holes) declared with a floorchange attribute in the pinned CrystalServer items.xml. Ladders, rope spots and sewer grates are scripted use actions and are not part of this family.",
  "oneOf": [
    {
      "$ref": "#/$defs/family_index"
    },
    {
      "$ref": "#/$defs/floor_change_shard"
    },
    {
      "$ref": "#/$defs/capture_summary"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "floor_change": {
      "enum": [
        "down",
        "up_east",
        "up_east_alt",
        "up_north",
        "up_south",
        "up_south_alt",
        "up_west"
      ]
    },
    "item_key": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(oteryn:item\\.[a-z0-9_.]+|donor:crystalserver@[0-9a-f]{8}:item/[0-9]+)$"
    },
    "floor_change_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration",
        "source_bindings"
      ],
      "properties": {
        "declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "floor_change",
            "identity",
            "item",
            "kind",
            "name",
            "object_kind",
            "occurrences_on_base_map",
            "provisional_item",
            "source_item_id"
          ],
          "properties": {
            "floor_change": {
              "$ref": "#/$defs/floor_change"
            },
            "identity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "revision"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "^oteryn:world_object\\.floor_change\\.[a-z0-9]+(_[a-z0-9]+)*$"
                },
                "revision": {
                  "const": "definition-r1"
                }
              }
            },
            "item": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "family",
                "key",
                "revision"
              ],
              "properties": {
                "family": {
                  "const": "Item"
                },
                "key": {
                  "$ref": "#/$defs/item_key"
                },
                "revision": {
                  "const": "definition-r1"
                }
              }
            },
            "kind": {
              "const": "WorldObject"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "object_kind": {
              "const": "floor_change"
            },
            "occurrences_on_base_map": {
              "type": "integer",
              "minimum": 0
            },
            "provisional_item": {
              "type": "boolean"
            },
            "source_item_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "source_bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "disposition",
              "external_id",
              "identity_namespace",
              "source_key",
              "source_revision",
              "target"
            ],
            "properties": {
              "disposition": {
                "const": "EXACT"
              },
              "external_id": {
                "type": "string",
                "pattern": "^[0-9]{1,5}$"
              },
              "identity_namespace": {
                "const": "crystalserver/items-xml-id"
              },
              "source_key": {
                "const": "oteryn:source.crystalserver"
              },
              "source_revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "family",
                  "key",
                  "revision"
                ],
                "properties": {
                  "family": {
                    "const": "WorldObject"
                  },
                  "key": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "revision": {
                    "const": "definition-r1"
                  }
                }
              }
            }
          }
        }
      }
    },
    "floor_change_shard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "records",
        "schema",
        "shard"
      ],
      "properties": {
        "family": {
          "const": "WorldObject.FloorChange"
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/floor_change_record"
          }
        },
        "schema": {
          "const": "OTERYN_WORLD_OBJECT_AUTHORING_SHARD/v1"
        },
        "shard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "end",
            "index",
            "start"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "end": {
              "type": "integer",
              "minimum": 0
            },
            "index": {
              "const": 0
            },
            "start": {
              "const": 0
            }
          }
        }
      }
    },
    "family_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "generator",
        "item_bindings",
        "population_state",
        "record_count",
        "schema",
        "shard_size",
        "shards",
        "source"
      ],
      "properties": {
        "family": {
          "const": "WorldObject.FloorChange"
        },
        "generator": {
          "const": "tools/content-schema/world-authoring/convert_floor_changes.py"
        },
        "item_bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "imports/crystalserver/bindings/items.json"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "population_state": {
          "const": "POPULATED"
        },
        "record_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "schema": {
          "const": "OTERYN_FAMILY_INDEX/v1"
        },
        "shard_size": {
          "const": 500
        },
        "shards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "pattern": "^content/world/objects/floor-changes-00000-[0-9]{5}\\.json$"
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence",
            "files",
            "ref",
            "repository",
            "revision",
            "source_key"
          ],
          "properties": {
            "evidence": {
              "const": "OtsHypothesisOnly"
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "const": "data/items/items.xml"
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "const": "zimbadev/crystalserver"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "source_key": {
              "const": "oteryn:source.crystalserver"
            }
          }
        }
      }
    },
    "capture_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_reference",
        "excluded",
        "floor_change_values",
        "item_types",
        "item_types_on_base_map",
        "kinds",
        "occurrences_on_base_map",
        "provisional_items",
        "schema",
        "source"
      ],
      "properties": {
        "engine_reference": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "reason"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "floor_change_values": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/floor_change"
          }
        },
        "item_types": {
          "type": "integer",
          "minimum": 1
        },
        "item_types_on_base_map": {
          "type": "integer",
          "minimum": 0
        },
        "kinds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "down",
            "up_east",
            "up_east_alt",
            "up_north",
            "up_south",
            "up_south_alt",
            "up_west"
          ],
          "properties": {
            "down": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item_types",
                "occurrences"
              ],
              "properties": {
                "item_types": {
                  "type": "integer",
                  "minimum": 0
                },
                "occurrences": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "up_east": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item_types",
                "occurrences"
              ],
              "properties": {
                "item_types": {
                  "type": "integer",
                  "minimum": 0
                },
                "occurrences": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "up_east_alt": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item_types",
                "occurrences"
              ],
              "properties": {
                "item_types": {
                  "type": "integer",
                  "minimum": 0
                },
                "occurrences": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "up_north": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item_types",
                "occurrences"
              ],
              "properties": {
                "item_types": {
                  "type": "integer",
                  "minimum": 0
                },
                "occurrences": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "up_south": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item_types",
                "occurrences"
              ],
              "properties": {
                "item_types": {
                  "type": "integer",
                  "minimum": 0
                },
                "occurrences": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "up_south_alt": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item_types",
                "occurrences"
              ],
              "properties": {
                "item_types": {
                  "type": "integer",
                  "minimum": 0
                },
                "occurrences": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "up_west": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item_types",
                "occurrences"
              ],
              "properties": {
                "item_types": {
                  "type": "integer",
                  "minimum": 0
                },
                "occurrences": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "occurrences_on_base_map": {
          "type": "integer",
          "minimum": 0
        },
        "provisional_items": {
          "type": "integer",
          "minimum": 0
        },
        "schema": {
          "const": "OTERYN_FLOOR_CHANGE_SOURCE_CAPTURE/v1"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence",
            "files",
            "ref",
            "repository",
            "revision",
            "source_key"
          ],
          "properties": {
            "evidence": {
              "const": "OtsHypothesisOnly"
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "const": "data/items/items.xml"
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "const": "zimbadev/crystalserver"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "source_key": {
              "const": "oteryn:source.crystalserver"
            }
          }
        }
      }
    }
  }
}
