{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oteryn:terrain-authoring:candidate:1",
  "title": "Oteryn Terrain definition (WO-0 §4.2)",
  "description": "One static Terrain catalog record per D93 family key. Facts use the KNOWN/UNKNOWN wrapper; an unknown fact is never defaulted. Not a placement and not runtime serialization.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "Terrain"
        },
        "key": {
          "type": "string",
          "pattern": "^oteryn:terrain\\.tibia\\.i[1-9][0-9]*$"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "family",
        "key",
        "revision"
      ]
    },
    "kind": {
      "oneOf": [
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "KNOWN"
            },
            "value": {
              "enum": [
                "ground",
                "border",
                "wall",
                "field",
                "roof"
              ]
            }
          },
          "required": [
            "state",
            "value"
          ]
        }
      ]
    },
    "walkable": {
      "$ref": "#/$defs/knownBool"
    },
    "ground_speed": {
      "$ref": "#/$defs/knownNonNegativeInteger"
    },
    "blocks_projectile": {
      "$ref": "#/$defs/knownBool"
    },
    "blocks_sight": {
      "$ref": "#/$defs/knownBool"
    },
    "floor_change": {
      "$ref": "#/$defs/knownText"
    },
    "automap": {
      "oneOf": [
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "KNOWN"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "shown": {
                  "type": "boolean"
                },
                "color": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              },
              "required": [
                "shown"
              ]
            }
          },
          "required": [
            "state",
            "value"
          ]
        }
      ]
    },
    "field": {
      "oneOf": [
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "KNOWN"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field_type": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "required": [
                "field_type"
              ]
            }
          },
          "required": [
            "state",
            "value"
          ]
        }
      ]
    },
    "behavior": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "KNOWN"
            },
            "value": {
              "enum": [
                "trash_holder",
                "teleport"
              ]
            }
          },
          "required": [
            "state",
            "value"
          ]
        }
      ]
    },
    "client_projection": {
      "$ref": "#/$defs/clientProjection"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "required": [
    "identity",
    "kind",
    "walkable",
    "blocks_projectile",
    "blocks_sight",
    "floor_change",
    "automap",
    "client_projection",
    "provenance"
  ],
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 512
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "UNKNOWN"
        }
      },
      "required": [
        "state"
      ]
    },
    "knownBool": {
      "oneOf": [
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "KNOWN"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "state",
            "value"
          ]
        }
      ]
    },
    "knownNonNegativeInteger": {
      "oneOf": [
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "KNOWN"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "state",
            "value"
          ]
        }
      ]
    },
    "knownText": {
      "oneOf": [
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "KNOWN"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "state",
            "value"
          ]
        }
      ]
    },
    "clientProjection": {
      "oneOf": [
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "KNOWN"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "appearance_id": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "appearance_id"
              ]
            }
          },
          "required": [
            "state",
            "value"
          ]
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "engine": {
              "enum": [
                "crystal"
              ]
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "profile": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "engine",
            "repository",
            "revision",
            "profile"
          ]
        },
        "source_item_id": {
          "type": "integer",
          "minimum": 1
        },
        "item_pointer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "family": {
              "const": "Item"
            },
            "key": {
              "type": "string",
              "pattern": "^oteryn:item\\.tibia\\.i[1-9][0-9]*$"
            },
            "revision": {
              "$ref": "#/$defs/revision"
            }
          },
          "required": [
            "family",
            "key",
            "revision"
          ]
        },
        "route": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "owner": {
              "enum": [
                "Terrain",
                "WorldObject"
              ]
            },
            "reason": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "owner",
            "reason"
          ]
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(appearance|items_xml|converter):[A-Za-z0-9_.]+$"
            }
          }
        }
      },
      "required": [
        "source",
        "source_item_id",
        "item_pointer",
        "route",
        "fields"
      ]
    },
    "knownSourceRef": {
      "description": "A relation to another source item id. It stays a source id here (source numeric ids are provenance, never identity) and is resolved to a typed definition reference by WO-2.",
      "oneOf": [
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "KNOWN"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_item_id": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "source_item_id"
              ]
            }
          },
          "required": [
            "state",
            "value"
          ]
        }
      ]
    }
  }
}
