  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 512
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "UNKNOWN"
        }
      },
      "required": [
        "state"
      ]
    },
    "knownBool": {
