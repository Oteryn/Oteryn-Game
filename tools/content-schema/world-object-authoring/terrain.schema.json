{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oteryn:terrain-authoring:candidate:1",
  "title": "Oteryn Terrain definition (WO-0 \u00a74.2)",
  "description": "One static Terrain catalog record per D93 family key. Facts use the KNOWN/UNKNOWN wrapper; an unknown fact is never defaulted. Not a placement and not runtime serialization.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "Terrain"
        },
        "key": {
          "type": "string",
          "pattern": "^oteryn:terrain\\.tibia\\.i[1-9][0-9]*$"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "family",
        "key",
        "revision"
      ]
    },
    "kind": {
      "oneOf": [
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "KNOWN"
            },
            "value": {
              "enum": [
                "ground",
                "border",
                "wall",
                "field",
                "roof",
                "common"
              ]
            }
          },
          "required": [
            "state",
            "value"
          ]
        }
      ]
    },
    "walkable": {
      "$ref": "#/$defs/knownBool"
    },
    "ground_speed": {
      "$ref": "#/$defs/knownNonNegativeInteger"
    },
    "blocks_projectile": {
      "$ref": "#/$defs/knownBool"
    },
    "blocks_sight": {
      "$ref": "#/$defs/knownBool"
    },
    "floor_change": {
      "$ref": "#/$defs/knownText"
    },
    "automap": {
      "oneOf": [
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "KNOWN"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "shown": {
                  "type": "boolean"
                },
                "color": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              },
              "required": [
                "shown"
              ]
            }
          },
          "required": [
            "state",
            "value"
          ]
        }
      ]
    },
    "field": {
      "oneOf": [
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "KNOWN"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field_type": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "required": [
                "field_type"
              ]
            }
          },
          "required": [
            "state",
            "value"
          ]
        }
      ]
    },
    "behavior": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "KNOWN"
            },
            "value": {
