{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oteryn:achievement-authoring:candidate:1",
  "title": "Achievement catalogue record (OTERYN_ACHIEVEMENT_OWNER_CONTRACT_V1 §2)",
  "description": "One catalogue entry. The key is the identity; client and wiki ids are provenance only. validate_achievements.py adds the rules JSON Schema cannot state: the key slug equals slug(name), points lie inside the grade's range, and keys are unique in a catalogue.",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "name", "description", "grade", "points", "secret", "premium", "provenance"],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "key", "revision"],
      "properties": {
        "family": { "const": "Achievement" },
        "key": { "type": "string", "pattern": "^oteryn:achievement/[a-z0-9]+(_[a-z0-9]+)*$" },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "grade": { "type": "integer", "minimum": 1, "maximum": 4 },
    "points": { "type": "integer", "minimum": 1, "maximum": 10 },
    "secret": { "type": "boolean" },
    "premium": { "type": "boolean" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "staticdata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_id", "client_version"],
          "properties": {
            "source_id": { "type": "integer", "minimum": 1 },
            "client_version": { "type": "string", "minLength": 1 }
          }
        },
        "tibiawiki": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pageid", "revid"],
          "properties": {
            "pageid": { "type": "integer", "minimum": 1 },
            "revid": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
