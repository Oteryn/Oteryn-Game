{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oteryn:charm-authoring:candidate:1",
  "title": "Charm authoring schema candidate v1 - structural validation",
  "description": "CANDIDATE static Charm definition catalogue (content/charms/). Not a runtime contract: Charm unlock, assignment and proc rules belong to rulesets/progression/charms/, a character's Charm points, echoes, unlocks and assignments are durable Character state. Semantic rules live in charm_authoring.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "charms"
  ],
  "properties": {
    "schema": {
      "const": "OTERYN_CHARM_AUTHORING_CATALOGUE/v1"
    },
    "charms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/charm"
      }
    }
  },
  "$defs": {
    "percent": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "element": {
      "enum": [
        "physical",
        "fire",
        "earth",
        "ice",
        "energy",
        "death",
        "holy"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "cost",
        "value"
      ],
      "properties": {
        "stage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "cost": {
          "type": "integer",
          "minimum": 1,
          "description": "Unlock cost of this stage in the category's currency (cost_currency)."
        },
        "value": {
          "$ref": "#/$defs/percent",
          "description": "The per-stage value; stage_value says what it measures."
        }
      }
    },
    "effect": {
      "description": "What the Charm does, one closed shape per type. Parameters that do not vary by stage live here; the per-stage value is in stages[].value.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "element",
            "percent_of_creature_max_health",
            "damage_cap_level_multiplier",
            "ignores_resistances",
            "reduced_by_armor"
          ],
          "properties": {
            "type": {
              "const": "attack_proc_damage"
            },
            "element": {
              "$ref": "#/$defs/element"
            },
            "percent_of_creature_max_health": {
              "$ref": "#/$defs/percent"
            },
            "damage_cap_level_multiplier": {
              "type": "integer",
              "minimum": 1,
              "description": "Damage is capped at this multiple of the character's level, before resistances."
            },
            "ignores_resistances": {
              "type": "boolean",
              "description": "true: the damage is neutral in effect (displayed as its element, not modified by the creature's resistances)."
            },
            "reduced_by_armor": {
              "type": "boolean",
              "description": "true: the creature's armor reduces the damage."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "element",
            "resource",
            "percent_of_own_maximum",
            "damage_cap_percent_of_creature_max_health",
            "ignores_resistances",
            "reduced_by_armor"
          ],
          "properties": {
            "type": {
              "const": "attack_proc_resource_damage"
            },
            "element": {
              "$ref": "#/$defs/element"
            },
            "resource": {
              "enum": [
                "health",
                "mana"
              ]
            },
            "percent_of_own_maximum": {
              "$ref": "#/$defs/percent"
            },
            "damage_cap_percent_of_creature_max_health": {
              "$ref": "#/$defs/percent"
            },
            "ignores_resistances": {
              "type": "boolean",
              "description": "true: the damage is neutral in effect (displayed as its element, not modified by the creature's resistances)."
            },
            "reduced_by_armor": {
              "type": "boolean",
              "description": "true: the creature's armor reduces the damage."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "element",
            "percent_of_creature_max_health",
            "ignores_resistances",
            "reduced_by_armor",
            "damage_cap_level_multiplier"
          ],
          "properties": {
            "type": {
              "const": "kill_area_damage"
            },
            "element": {
              "$ref": "#/$defs/element"
            },
            "percent_of_creature_max_health": {
              "$ref": "#/$defs/percent"
            },
            "ignores_resistances": {
              "type": "boolean",
              "description": "true: the damage is neutral in effect (displayed as its element, not modified by the creature's resistances)."
            },
            "reduced_by_armor": {
              "type": "boolean",
              "description": "true: the creature's armor reduces the damage."
            },
            "damage_cap_level_multiplier": {
              "type": "integer",
              "minimum": 1,
              "description": "Damage to each creature is capped at this multiple of the character's level."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "element",
            "ignores_resistances",
            "reduced_by_armor"
          ],
          "properties": {
            "type": {
              "const": "reflect_damage_taken"
            },
            "element": {
              "$ref": "#/$defs/element"
            },
            "ignores_resistances": {
              "type": "boolean",
              "description": "true: the damage is neutral in effect (displayed as its element, not modified by the creature's resistances)."
            },
            "reduced_by_armor": {
              "type": "boolean",
              "description": "true: the creature's armor reduces the damage."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "duration_ms"
          ],
          "properties": {
            "type": {
              "enum": [
                "paralyse_creature_on_attack",
                "paralyse_creature_after_its_attack",
                "haste_after_hit",
                "prevent_creature_flee"
              ]
            },
            "duration_ms": {
              "$ref": "#/$defs/duration_ms"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "dodge_attack",
                "cleanse_after_hit",
                "death_loss_reduction",
                "skinning_chance_bonus",
                "creature_product_bonus",
                "critical_hit_chance",
                "critical_extra_damage",
                "life_leech",
                "mana_leech",
                "mana_drain_inversion"
              ]
            }
          }
        }
      ]
    },
    "wikiSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "pageid",
        "revid",
        "wikitext_sha256"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "pageid": {
          "type": "integer",
          "minimum": 1
        },
        "revid": {
          "type": "integer",
          "minimum": 1
        },
        "wikitext_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "canarySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "path",
        "file_sha256",
        "charm_id"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "charm_id": {
          "type": "integer",
          "minimum": 0,
          "description": "Canary Game.createBestiaryCharm id (list position minus one). Hypothesis evidence; the client protocol id is not verified here."
        }
      }
    },
    "charm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "category",
        "kind",
        "cost_currency",
        "stage_value",
        "stages",
        "effect",
        "implemented_version",
        "sources"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^oteryn:charm\\.[a-z0-9_]+$",
          "maxLength": 512,
          "description": "Proposed authoring key: lowercase name, non-alphanumerics folded to _. Not minted until content population."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "category": {
          "enum": [
            "major",
            "minor"
          ]
        },
        "kind": {
          "enum": [
            "offensive",
            "defensive",
            "passive"
          ]
        },
        "cost_currency": {
          "enum": [
            "charm_points",
            "minor_charm_echoes"
          ],
          "description": "Major charms are bought with Charm Points, minor charms with Minor Charm Echoes."
        },
        "stage_value": {
          "enum": [
            "trigger_chance_percent",
            "effect_percent"
          ]
        },
        "stages": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "effect": {
          "$ref": "#/$defs/effect"
        },
        "implemented_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9a-f]+)?$"
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tibiawiki",
            "canary"
          ],
          "properties": {
            "tibiawiki": {
              "$ref": "#/$defs/wikiSource"
            },
            "canary": {
              "$ref": "#/$defs/canarySource"
            }
          }
        }
      }
    }
  }
}
