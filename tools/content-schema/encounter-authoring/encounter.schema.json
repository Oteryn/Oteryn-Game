{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "instance_per_party",
        "channel_shared"
      ]
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "creatures": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/CreatureRef"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "role",
          "creatures"
        ]
      },
      "minItems": 1
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "enum": [
              "point",
              "area"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "key",
          "kind",
          "description"
        ]
      },
      "minItems": 0
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "counters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "initial": {
                "type": "integer"
              }
            },
            "required": [
              "name",
              "initial"
            ]
          },
          "minItems": 0
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "initial": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "initial"
            ]
          },
          "minItems": 0
        },
        "timers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 1
              },
              "repeat": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "duration_ms",
              "repeat"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "counters",
        "flags",
        "timers"
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      },
      "minItems": 1
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "reset_after_ms": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "identity",
    "display_name",
    "scope",
    "participants",
    "anchors",
    "phases",
    "state",
    "rules",
    "outcomes"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oteryn:encounter-authoring/v1",
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*:[a-z0-9_./-]+$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key",
        "revision"
      ]
    },
    "CreatureRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "Creature"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*:[a-z0-9_./-]+$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "family",
        "key",
        "revision"
      ]
    },
    "ItemRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "Item"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*:[a-z0-9_./-]+$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "family",
        "key",
        "revision"
      ]
    },
    "AbilityRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "Ability"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*:[a-z0-9_./-]+$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "family",
        "key",
        "revision"
      ]
    },
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "role"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "killer": {
              "const": true
            }
          },
          "required": [
            "killer"
          ]
        }
      ]
    },
    "health": {
      "oneOf": [
        {
          "enum": [
            "full",
            "keep_percent",
            "keep_absolute"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "percent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "percent"
          ]
        }
      ]
    },
    "position": {
      "oneOf": [
        {
          "enum": [
            "death_position",
            "subject_position"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "anchor": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "anchor"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "random_in": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "random_in"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "offset_tiles": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "offset_tiles"
          ]
        }
      ]
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "creature_died"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "kind",
            "role"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "lethal_damage"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "kind",
            "role"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "health_crossed"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "percent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            }
          },
          "required": [
            "kind",
            "role",
            "percent"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "damage_taken"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "source": {
              "enum": [
                "player",
                "any"
              ]
            }
          },
          "required": [
            "kind",
            "role",
            "source"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "damage_accumulated"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "amount": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "role",
            "amount"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "timer_elapsed"
            },
            "timer": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "kind",
            "timer"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "counter_reached"
            },
            "counter": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "value": {
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "counter",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "area_entered"
            },
            "anchor": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "who": {
              "enum": [
                "player",
                "role"
              ]
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "kind",
            "anchor",
            "who"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "area_left"
            },
            "anchor": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "who": {
              "enum": [
                "player",
                "role"
              ]
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "kind",
            "anchor",
            "who"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "phase_entered"
            },
            "phase": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "kind",
            "phase"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "encounter_started"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "encounter_reset"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "chance_percent"
            },
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "counter_compare"
            },
            "counter": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "op": {
              "enum": [
                "==",
                "!=",
                "<",
                "<=",
                ">",
                ">="
              ]
            },
            "value": {
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "counter",
            "op",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "flag"
            },
            "flag": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "flag",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "creature_present"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "anchor": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "present": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "role",
            "anchor",
            "present"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "in_anchor"
            },
            "subject": {
              "$ref": "#/$defs/subject"
            },
            "anchor": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "kind",
            "subject",
            "anchor"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "killer_is_player"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "has_master"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "role",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "health_percent"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "op": {
              "enum": [
                "==",
                "!=",
                "<",
                "<=",
                ">",
                ">="
              ]
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "kind",
            "role",
            "op",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "attacker_wears"
            },
            "item": {
              "$ref": "#/$defs/ItemRef"
            },
            "wears": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "item",
            "wears"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "killer_progress"
            },
            "progress": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*:[a-z0-9_./-]+$"
            },
            "op": {
              "enum": [
                "==",
                "!=",
                "<",
                "<=",
                ">",
                ">="
              ]
            },
            "value": {
              "type": [
                "integer",
                "boolean"
              ]
            }
          },
          "required": [
            "kind",
            "progress",
            "op",
            "value"
          ]
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "spawn"
            },
            "creature": {
              "$ref": "#/$defs/CreatureRef"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "at": {
              "$ref": "#/$defs/position"
            },
            "owner": {
              "enum": [
                "none",
                "subject"
              ]
            },
            "health": {
              "$ref": "#/$defs/health"
            }
          },
          "required": [
            "kind",
            "creature",
            "count",
            "at",
            "owner",
            "health"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "remove"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "all_in": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "transform"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "into": {
              "oneOf": [
                {
                  "$ref": "#/$defs/CreatureRef"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "next_stage": {
                      "const": true
                    }
                  },
                  "required": [
                    "next_stage"
                  ]
                }
              ]
            },
            "health": {
              "$ref": "#/$defs/health"
            }
          },
          "required": [
            "kind",
            "role",
            "into",
            "health"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "heal"
            },
            "subject": {
              "$ref": "#/$defs/subject"
            },
            "amount": {
              "oneOf": [
                {
                  "const": "full"
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ]
            }
          },
          "required": [
            "kind",
            "subject",
            "amount"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "prevent_death"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "kind",
            "role"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "damage_modifier"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "multiplier_percent": {
              "type": "integer",
              "minimum": 0
            },
            "damage_types": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "sources": {
              "enum": [
                "player",
                "any"
              ]
            },
            "until": {
              "enum": [
                "this_hit",
                "reset",
                "timer"
              ]
            },
            "timer": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "kind",
            "role",
            "multiplier_percent",
            "sources",
            "until"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "reflect_damage"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "percent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "damage_types": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "role",
            "percent"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "convert_damage_to_heal"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "damage_types": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "role"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
