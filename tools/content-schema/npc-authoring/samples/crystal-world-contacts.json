      "greet": [
        "Visitors at last. Perhaps you are capable of helping me."
      ],
      "farewell": [
        "Come back after you have dealt with the majordomo."
      ],
      "keywords": [
        {
          "key": "abomination",
          "triggers": [
            "abomination"
          ],
          "reply": [
            "Destroy the creature before this experiment gets any further."
          ]
        },
        {
          "key": "believers",
          "triggers": [
            "believers"
          ],
          "reply": [
            "I joined the cult, became its prophet and gave it a purpose of my own."
          ]
        },
        {
          "key": "capable",
          "triggers": [
            "capable"
          ],
          "reply": [
            "Welcome to my prison. We have a problem in common."
          ]
        },
        {
          "key": "creation",
          "triggers": [
            "creation"
          ],
          "reply": [
            "We built this palace from air, moonsilver and belief. Then failure."
          ]
        },
        {
          "key": "explain",
          "triggers": [
            "explain"
          ],
          "reply": [
            "Smaller fragments fell before the moonrock struck Thalassara. I collected some samples."
          ]
        },
        {
          "key": "failure",
          "triggers": [
            "failure"
          ],
          "reply": [
            "The devotion of my followers was stronger than I reckoned. They made their own god."
          ]
        },
        {
          "key": "god",
          "triggers": [
            "god"
          ],
          "reply": [
            "Their belief made it real. It thinks the world is its to rule."
          ]
        },
        {
          "key": "helping",
          "triggers": [
            "helping"
          ],
          "reply": [
            "You can act outside my prison. I can tell you what to do when you get there."
          ]
        },
        {
          "key": "hesitate",
          "triggers": [
            "hesitate"
          ],
          "reply": [
            "I concealed your arrival. I can keep its eye off you while you cross the palace."
          ]
        },
        {
          "key": "interaction",
          "triggers": [
            "interaction"
          ],
          "reply": [
            "The material answers a singular purpose. I found that focus in devoted believers."
          ]
        },
        {
          "key": "job",
          "triggers": [
            "job"
          ],
          "reply": [
            "I conduct experiments. The others might call them reckless."
          ]
        },
        {
          "key": "moonsilver",
          "triggers": [
            "moonsilver"
          ],
          "reply": [
            "I have never worked with anything more promising or more regrettable."
          ]
        },
        {
          "key": "name",
          "triggers": [
            "name"
          ],
          "reply": [
            "Doctor Marrow. My reputation seems to arrive before me."
          ]
        },
        {
          "key": "prison",
          "triggers": [
            "prison"
          ],
          "reply": [
            "You might be tempted to reach me if these bars were gone. Let me explain."
          ]
        },
        {
          "key": "purpose",
          "triggers": [
            "purpose"
          ],
          "reply": [
            "My followers and I secured the moonrock and began to harvest it. Then came creation."
          ]
        },
        {
          "key": "samples",
          "triggers": [
            "samples"
          ],
          "reply": [
            "Moonsilver has a peculiar interaction with the mind."
          ]
        },
        {
          "key": "stopped",
          "triggers": [
            "stopped"
          ],
          "reply": [
            "Start with the majordomo, the servant most devoted to it."
          ]
        },
        {
          "key": "unpleasant",
          "triggers": [
            "unpleasant"
          ],
          "reply": [
            "It keeps me here because I am useful. It must be stopped before it reaches beyond the palace."
          ]
        },
        {
          "key": "wayland",
          "triggers": [
            "wayland"
          ],
          "reply": [
            "My assistant. He worries easily, but he knows how to find capable people."
          ]
        }
      ]
    },
