    {
      "kind": "Dialogue",
      "identity": {
        "key": "oteryn:dialogue.npc.eustacios_spy_rat",
        "revision": "definition-r1"
      },
      "fields": [],
      "greet": [
        "Keep your voice down."
      ],
      "farewell": [
        "Go on, then."
      ],
      "keywords": [
        {
          "key": "advantage",
          "triggers": [
            "advantage"
          ],
          "reply": [
            "Use the terrain and stay out of sight. Bring parcels if you need help climbing."
          ]
        },
        {
          "key": "assistance",
          "triggers": [
            "assistance"
          ],
          "reply": [
            "I set a disguise by the laboratory entrance. Get inside and find the chest with the mouldy powder."
          ]
        },
        {
          "key": "convincing",
          "triggers": [
            "convincing"
          ],
          "reply": [
            "Keep out of the light and away from the guards. Watch for the glowing bugs to dim."
          ]
        },
        {
          "key": "disguise",
          "triggers": [
            "disguise"
          ],
          "reply": [
            "It will fool someone at a distance in the dark. The magic fades, so move quickly."
          ]
        },
        {
          "key": "job",
          "triggers": [
            "job"
          ],
          "reply": [
            "I am a pirate who likes being paid in cheese."
          ]
        },
        {
          "key": "loud",
          "triggers": [
            "loud"
          ],
          "reply": [
            "I would lose my job if I were seen with you. Good thing Eustacio sent word and cheese."
          ]
        },
        {
          "key": "people",
          "triggers": [
            "people"
          ],
          "reply": [
            "Eustacio brings the cheese. I provide assistance."
          ]
        }
      ]
    },
