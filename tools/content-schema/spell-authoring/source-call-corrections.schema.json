    "qualification_limit": {
      "const": "Per-file counts reconciled; no call-identity bijection, execution, binding, or mechanics qualification asserted."
    },
    "runtime_activation": {
      "const": false
    },
    "execution_qualified": {
      "const": false
    },
    "native_admission": {
      "const": false
    },
    "source_code_activation": {
      "const": false
    },
    "mechanics_completion_claim": {
      "const": false
    }
