      "properties": {
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "gzip_sha256",
            "payload_sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "gzip_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "payload_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "ast": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "gzip_sha256",
            "payload_sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "gzip_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "payload_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "fact_hash_encoding": {
      "const": "utf8_json_sort_keys_compact_separators_ensure_ascii_false"
