          "type": "object",
          "additionalProperties": false,
          "required": [
            "and",
            "or",
            "not"
          ],
          "properties": {
            "and": {
              "type": "integer",
              "minimum": 0
            },
            "or": {
              "type": "integer",
              "minimum": 0
            },
            "not": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "corrections": {
      "type": "array",
