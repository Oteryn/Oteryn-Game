          },
          "frozen_call_fact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reason": {
            "const": "reserved_lua_operator_misclassified_as_call"
          },
          "disposition": {
            "const": "exclude_from_call_counts_preserve_source_operator_in_ast"
          }
        }
      }
    },
    "per_file_reconciliation": {
      "type": "array",
      "minItems": 2346,
      "maxItems": 2346,
      "items": {
        "type": "object",
