          "type": "integer",
          "minimum": 0
        },
        "frozen_unsupported_call_references": {
          "type": "integer",
          "minimum": 0
        },
        "corrected_unsupported_call_references": {
          "type": "integer",
          "minimum": 0
        },
        "per_file_count_mismatches": {
          "type": "integer",
          "minimum": 0
