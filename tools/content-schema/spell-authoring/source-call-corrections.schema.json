            "type": "integer",
            "minimum": 0
          },
          "excluded_operator_count": {
            "type": "integer",
            "minimum": 0
          },
          "corrected_call_count": {
            "type": "integer",
            "minimum": 0
          },
          "ast_call_invoke_count": {
            "type": "integer",
            "minimum": 0
          },
          "count_equal": {
            "const": true
          }
        }
      }
