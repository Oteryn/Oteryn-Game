            "raw_expression": "function onDeathForDamagingPlayers(creature, func)\n\tfor key, value in pairs(creature:getDamageMap()) do\n\t\tlocal player = Player(key)\n\t\tif player then\n\t\t\tfunc(creature, player)\n\t\tend\n\tend\nend",
