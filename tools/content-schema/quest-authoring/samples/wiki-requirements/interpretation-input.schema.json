{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceNode": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "value",
            "binding_status",
            "applies_to"
          ],
          "properties": {
            "kind": {
              "const": "level_at_least"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            },
            "binding_status": {
              "const": "SOURCE_DECLARED"
            },
            "applies_to": {
              "enum": [
                "alternative_entity",
                "mission_or_addon",
                "full_completion",
                "world",
                "source_requirement_list"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "entity",
            "quantity",
            "binding_status",
            "source_namespace"
          ],
          "properties": {
            "kind": {
              "enum": [
                "entity_reference",
                "entity_use_reference",
                "quest_completion_reference",
                "quest_stage_reference"
              ]
            },
            "entity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "not": {
                "pattern": "^(?:[Ii]mage|[Ff]ile|[Aa]rquivo|[Ff]icheiro):"
              }
            },
            "quantity": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "binding_status": {
              "const": "UNKNOWN"
            },
            "source_namespace": {
              "const": "mediawiki/page_title"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "sourceExpression": {
      "type": "object",
      "required": [
        "line",
        "line_sha256",
        "section",
        "scope",
        "scope_anchor",
        "operator",
        "execution_semantics",
        "declaration_strength",
        "nodes"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "line_sha256": {
          "$ref": "#/$defs/hash"
        },
        "section": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "mission_only",
            "daily_task",
            "recommendation",
            "source_requirement_list",
            "optional",
            "entity_only",
            "completion_only"
          ]
        },
        "scope_anchor": {
          "type": [
            "string",
            "null"
          ]
        },
        "operator": {
          "enum": [
            "references",
            "any_of_references"
          ]
        },
        "execution_semantics": {
          "const": "UNKNOWN"
        },
        "declaration_strength": {
          "enum": [
            "reference_only",
            "explicit",
            "uncertain"
          ]
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceNode"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "wiki_title": {
        "type": "string",
        "minLength": 1
      },
      "historical_hold_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "historical_evidence": {
        "type": "object",
        "properties": {
          "provider": {
            "enum": [
              "tibia_fandom",
              "tibiawiki_br"
            ]
          },
          "relation": {
            "enum": [
              "base",
              "spoiler",
              "crosscheck"
            ]
          },
          "pageid": {
            "type": "integer",
            "minimum": 1
          },
          "revid": {
            "type": "integer",
            "minimum": 1
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "line_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "provider",
          "relation",
          "pageid",
          "revid",
          "content_sha256",
          "url",
          "line",
          "line_sha256"
        ],
        "additionalProperties": false
      },
      "execution_semantics": {
        "const": "UNKNOWN"
      },
      "canonical_binding_status": {
        "const": "UNKNOWN"
      },
      "prerequisite_expressions": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/sourceExpression"
        }
      },
      "source_fact_entries": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "curated_source_fact"
            },
            "source_order": {
              "type": "integer",
              "minimum": 0
            },
            "execution_semantics": {
              "const": "UNKNOWN"
            },
            "binding_status": {
              "const": "UNKNOWN"
            },
            "classification": {
              "const": "DERIVED"
            },
            "scope": {
              "type": "string"
            },
            "facts": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "required_amount_literal": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "unit_literal": {
                      "type": "string",
                      "minLength": 1
                    },
                    "scope_literal": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "required_amount_literal",
                    "unit_literal",
                    "scope_literal"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "required_amount_literal": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "unit_literal": {
                      "const": "War Exp pontos"
                    },
                    "scope_literal": {
                      "type": "string",
                      "minLength": 1
                    },
                    "cumulative_declared": {
                      "const": true
                    },
                    "excluded_additive_terms": {
                      "type": "array",
                      "minItems": 2,
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "required": [
                    "required_amount_literal",
                    "unit_literal",
                    "scope_literal",
                    "cumulative_declared",
                    "excluded_additive_terms"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "required_title_literal": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "required_title_literal"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "optional_mission_heading": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "optional_mission_heading"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "requirement_category": {
                      "type": "string",
                      "minLength": 1
                    },
                    "required_quantity": {
                      "const": null
                    }
                  },
                  "required": [
                    "requirement_category",
                    "required_quantity"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "required_component_literal": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "required_component_literal"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "required_defeated_group_literal": {
                      "type": "string",
                      "minLength": 1
                    },
                    "group_quantifier": {
                      "const": "all"
                    }
                  },
                  "required": [
                    "required_defeated_group_literal",
                    "group_quantifier"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "minimum_level_literal": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "scope_literal": {
                      "const": "some_locations"
                    }
                  },
                  "required": [
                    "minimum_level_literal",
                    "scope_literal"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "recommendation_category": {
                      "const": "protection"
                    },
                    "location_label": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "recommendation_category",
                    "location_label"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "line_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "byte_offset": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "byte_length": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "span_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "line",
                  "line_sha256",
                  "byte_offset",
                  "byte_length",
                  "span_sha256"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "source_order",
            "execution_semantics",
            "binding_status",
            "classification",
            "scope",
            "facts",
            "evidence"
          ],
          "additionalProperties": false
        }
      },
      "source_scope_kind": {
        "enum": [
          "source_requirement_reference",
          "recommendation_only"
        ]
      },
      "unresolved_semantics": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "classification"
          ],
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "classification": {
              "const": "UNKNOWN"
            }
          }
        }
      }
    },
    "required": [
      "wiki_title",
      "historical_hold_sha256",
      "historical_evidence",
      "execution_semantics",
      "canonical_binding_status",
      "prerequisite_expressions",
      "source_fact_entries"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "required": [
            "unresolved_semantics"
          ]
        },
        "then": {
          "required": [
            "source_scope_kind"
          ]
        }
      }
    ]
  }
}
