    "rule": {
      "oneOf": [
        {
          "$ref": "#/$defs/child"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "branch"
          ],
          "properties": {
            "branch": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "when",
                  "then"
                ],
                "properties": {
                  "when": {
                    "$ref": "#/$defs/condition"
                  },
                  "then": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/rule"
                    }
                  }
                }
              }
            },
            "otherwise": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/rule"
              }
            }
          }
        }
      ]
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "source",
        "rules",
        "anchors",
        "unresolved"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "revision"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+:interaction/[a-z0-9_]+(/[a-z0-9_]+)*$"
            },
            "revision": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "edge",
