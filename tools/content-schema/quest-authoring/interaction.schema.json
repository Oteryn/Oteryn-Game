{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oteryn:schema/interaction/v1",
  "title": "Oteryn interaction definition v1 (CANDIDATE, D36; relocation D37 and world-object overlay D38): source edge, read-only conditions, owner-delegated children",
  "type": "object",
  "additionalProperties": false,
  "required": ["interactions"],
  "properties": {"interactions": {"type": "array", "items": {"$ref": "#/$defs/interaction"}}},
  "$defs": {
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["family", "key", "revision"],
      "properties": {"family": {"enum": ["Achievement", "Creature", "Item"]}, "key": {"type": "string", "pattern": "^[a-z0-9_-]+:[a-z0-9_./-]+$"},
                     "revision": {"type": "string", "minLength": 1}}
    },
    "progress": {"type": "string", "pattern": "^[a-z0-9_-]+:quest-progress/[a-z0-9_./-]+$"},
    "world_state": {"type": "string", "pattern": "^[a-z0-9_-]+:world-state/[a-z0-9_]+$"},
    "op": {"enum": ["==", "~=", "<", "<=", ">", ">="]},
    "anchor_key": {"type": "string", "pattern": "^p[0-9]+$"},
    "relocation_target": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "anchor"],
         "properties": {"kind": {"const": "anchor"}, "anchor": {"$ref": "#/$defs/anchor_key"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"],
         "properties": {"kind": {"const": "previous_position"}}}
      ]
    },
    "condition": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["quest_stage", "negate"],
         "properties": {"negate": {"type": "boolean"},
                        "quest_stage": {"type": "object", "additionalProperties": false, "required": ["progress", "op", "value"],
                                        "properties": {"progress": {"$ref": "#/$defs/progress"}, "op": {"$ref": "#/$defs/op"},
                                                       "value": {"type": "integer"}}}}},
        {"type": "object", "additionalProperties": false, "required": ["world_state", "negate"],
         "properties": {"negate": {"type": "boolean"},
                        "world_state": {"type": "object", "additionalProperties": false, "required": ["key", "op", "value"],
                                        "properties": {"key": {"$ref": "#/$defs/world_state"}, "op": {"$ref": "#/$defs/op"},
                                                       "value": {"type": "integer"}}}}},
        {"type": "object", "additionalProperties": false, "required": ["actor_is_player", "negate"],
         "properties": {"actor_is_player": {"const": true}, "negate": {"type": "boolean"}}},
        {"type": "object", "additionalProperties": false, "required": ["actor_level", "negate"],
         "properties": {"negate": {"type": "boolean"},
                        "actor_level": {"type": "object", "additionalProperties": false, "required": ["op", "value"],
                                        "properties": {"op": {"$ref": "#/$defs/op"}, "value": {"type": "integer", "minimum": 0}}}}},
        {"type": "object", "additionalProperties": false, "required": ["actor_item_count", "negate"],
         "properties": {"negate": {"type": "boolean"},
                        "actor_item_count": {"type": "object", "additionalProperties": false, "required": ["item", "op", "value"],
                                             "properties": {"item": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"family": {"const": "Item"}}}]},
                                                            "op": {"$ref": "#/$defs/op"}, "value": {"type": "integer", "minimum": 0}}}}},
        {"type": "object", "additionalProperties": false, "required": ["object", "negate"],
         "properties": {"negate": {"type": "boolean"},
                        "object": {"type": "object", "additionalProperties": false, "required": ["role", "field", "op"],
                                   "properties": {"role": {"enum": ["source", "contact", "use_target"]},
                                                  "field": {"enum": ["item_type", "unique_id", "action_id", "subtype"]},
                                                  "op": {"enum": ["==", "~="]}, "item": {"$ref": "#/$defs/ref"},
                                                  "value": {"type": "integer", "minimum": 0}},
                                   "if": {"properties": {"field": {"const": "item_type"}}},
                                   "then": {"required": ["item"], "not": {"required": ["value"]},
                                            "properties": {"item": {"properties": {"family": {"const": "Item"}}}}},
                                   "else": {"required": ["value"], "not": {"required": ["item"]}}}}},
        {"type": "object", "additionalProperties": false, "required": ["all"],
         "properties": {"all": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/condition"}}}},
        {"type": "object", "additionalProperties": false, "required": ["any"],
         "properties": {"any": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/condition"}}}},
        {"type": "object", "additionalProperties": false, "required": ["unresolved"],
         "properties": {"unresolved": {"type": "object", "additionalProperties": false, "required": ["line"],
                                       "properties": {"line": {"type": "integer", "minimum": 1}}}}}
      ]
    },
    "child": {
      "type": "object",
      "required": ["owner"],
      "properties": {"owner": {"enum": ["Quest", "Ability", "Item", "Achievement", "Movement", "WorldObject", "Presentation", "Outfit", "Mount", "Experience"]}, "repeated": {"const": true}},
      "oneOf": [
        {"properties": {"owner": {"const": "Quest"}, "request": {"const": "set_progress"}, "progress": {"$ref": "#/$defs/progress"},
                        "to": {"type": "integer"}, "value_source_line": {"type": "integer"},
                        "transition": {"type": "string", "pattern": "^[a-z0-9_-]+:quest/[a-z0-9_]+#[a-z0-9_]+:[a-z_]+_[0-9]+$"},
                        "repeated": {"const": true}},
         "required": ["request", "progress"], "additionalProperties": false},
        {"properties": {"owner": {"const": "Quest"}, "request": {"const": "set_world_state"}, "key": {"$ref": "#/$defs/world_state"},
                        "to": {"type": "integer"}, "value_source_line": {"type": "integer"}, "repeated": {"const": true}},
         "required": ["request", "key"], "additionalProperties": false},
        {"properties": {"owner": {"const": "Ability"}, "effect": {"const": "summon"}, "creature": {"$ref": "#/$defs/ref"},
                        "anchor": {"$ref": "#/$defs/anchor_key"}, "anchor_source_line": {"type": "integer"}, "repeated": {"const": true}},
         "required": ["effect", "creature"], "additionalProperties": false},
        {"properties": {"owner": {"const": "Item"}, "request": {"const": "hand_out"},
                        "item": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"family": {"const": "Item"}}}]},
                        "count": {"type": "integer", "minimum": 1}, "value_source_line": {"type": "integer"},
                        "contents": {"type": "array", "minItems": 1, "items": {
                          "type": "object", "additionalProperties": false, "required": ["item", "count"],
                          "properties": {"item": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"family": {"const": "Item"}}}]},
                                         "count": {"type": "integer", "minimum": 1}}}},
                        "repeated": {"const": true}},
         "required": ["request"], "additionalProperties": false,
         "oneOf": [{"required": ["item", "count"]}, {"required": ["value_source_line"]}]},
        {"properties": {"owner": {"const": "Item"}, "request": {"const": "consume"},
                        "item": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"family": {"const": "Item"}}}]},
                        "count": {"type": "integer", "minimum": 1}, "object": {"enum": ["used_item", "contact"]},
                        "value_source_line": {"type": "integer"}, "repeated": {"const": true}},
         "required": ["request"], "additionalProperties": false,
         "oneOf": [{"required": ["item", "count"]}, {"required": ["object"]}, {"required": ["value_source_line"]}]},
        {"properties": {"owner": {"const": "Achievement"}, "request": {"const": "grant"},
                        "achievement": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"family": {"const": "Achievement"}}}]},
                        "value_source_line": {"type": "integer"}, "repeated": {"const": true}},
         "required": ["request"], "additionalProperties": false,
         "oneOf": [{"required": ["achievement"]}, {"required": ["value_source_line"]}]},
        {"properties": {"owner": {"const": "Movement"}, "request": {"const": "relocate"}, "scope": {"const": "in_scope"},
                        "target": {"$ref": "#/$defs/relocation_target"}, "repeated": {"const": true}},
         "required": ["request", "scope", "target"], "additionalProperties": false},
        {"properties": {"owner": {"const": "Movement"}, "status": {"const": "blocked"}, "reason": {"type": "string"},
                        "to_source_line": {"type": "integer"}, "repeated": {"const": true}},
         "required": ["status", "reason", "to_source_line"], "additionalProperties": false},
        {"properties": {"owner": {"const": "WorldObject"}, "operation": {"const": "TRANSFORM"},
                        "anchor": {"$ref": "#/$defs/anchor_key"},
                        "from": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"family": {"const": "Item"}}}]},
                        "to": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"family": {"const": "Item"}}}]},
                        "value_source_line": {"type": "integer"}, "revert_after_ms": {"type": "integer", "minimum": 1},
                        "repeated": {"const": true}},
         "required": ["operation"], "additionalProperties": false,
         "oneOf": [{"required": ["from", "to"]}, {"required": ["value_source_line"]}]},
        {"properties": {"owner": {"const": "WorldObject"}, "operation": {"const": "CREATE"},
                        "anchor": {"$ref": "#/$defs/anchor_key"},
                        "def": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"family": {"const": "Item"}}}]},
                        "value_source_line": {"type": "integer"}, "revert_after_ms": {"type": "integer", "minimum": 1},
                        "repeated": {"const": true}},
         "required": ["operation"], "additionalProperties": false,
         "oneOf": [{"required": ["def"]}, {"required": ["value_source_line"]}]},
        {"properties": {"owner": {"const": "WorldObject"}, "operation": {"const": "REMOVE"},
                        "anchor": {"$ref": "#/$defs/anchor_key"},
                        "def": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"family": {"const": "Item"}}}]},
                        "value_source_line": {"type": "integer"}, "revert_after_ms": {"type": "integer", "minimum": 1},
                        "repeated": {"const": true}},
         "required": ["operation"], "additionalProperties": false,
         "oneOf": [{"required": ["def"]}, {"required": ["value_source_line"]}]},
        {"properties": {"owner": {"const": "WorldObject"}, "operation": {"const": "RETAG"},
                        "anchor": {"$ref": "#/$defs/anchor_key"}, "value_source_line": {"type": "integer"},
                        "revert_after_ms": {"type": "integer", "minimum": 1}, "repeated": {"const": true}},
         "required": ["operation", "value_source_line"], "additionalProperties": false},
        {"properties": {"owner": {"const": "WorldObject"}, "status": {"const": "blocked"}, "reason": {"type": "string"},
                        "source_line": {"type": "integer"}, "repeated": {"const": true}},
         "required": ["status", "reason", "source_line"], "additionalProperties": false},
        {"properties": {"owner": {"const": "Presentation"}, "effect": {"const": "magic_effect"}, "authoritative": {"const": false},
                        "repeated": {"const": true}},
         "required": ["effect", "authoritative"], "additionalProperties": false},
        {"properties": {"owner": {"const": "Presentation"}, "effect": {"const": "message"}, "authoritative": {"const": false},
                        "source_line": {"type": "integer", "minimum": 1}, "repeated": {"const": true}},
         "required": ["effect", "authoritative", "source_line"], "additionalProperties": false},
        {"properties": {"owner": {"const": "Presentation"}, "effect": {"const": "map_mark"}, "authoritative": {"const": false},
                        "source_line": {"type": "integer", "minimum": 1}, "repeated": {"const": true}},
         "required": ["effect", "authoritative", "source_line"], "additionalProperties": false},
        {"properties": {"owner": {"const": "Outfit"}, "request": {"const": "grant"},
                        "looktype": {"type": "integer", "minimum": 0}, "addon": {"type": "integer", "minimum": 0, "maximum": 3},
                        "value_source_line": {"type": "integer"}, "repeated": {"const": true}},
         "required": ["request"], "additionalProperties": false,
         "oneOf": [{"required": ["looktype"]}, {"required": ["value_source_line"]}]},
        {"properties": {"owner": {"const": "Mount"}, "request": {"const": "grant"},
                        "mount": {"type": "integer", "minimum": 0}, "value_source_line": {"type": "integer"},
                        "repeated": {"const": true}},
         "required": ["request"], "additionalProperties": false,
         "oneOf": [{"required": ["mount"]}, {"required": ["value_source_line"]}]},
        {"properties": {"owner": {"const": "Experience"}, "request": {"const": "grant"},
                        "amount": {"type": "integer", "minimum": 0}, "value_source_line": {"type": "integer"},
                        "repeated": {"const": true}},
         "required": ["request"], "additionalProperties": false,
         "oneOf": [{"required": ["amount"]}, {"required": ["value_source_line"]}]}
      ]
    },
    "rule": {
      "oneOf": [
        {"$ref": "#/$defs/child"},
        {"type": "object", "additionalProperties": false, "required": ["branch"],
         "properties": {
           "branch": {"type": "array", "minItems": 1, "items": {
             "type": "object", "additionalProperties": false, "required": ["when", "then"],
             "properties": {"when": {"$ref": "#/$defs/condition"}, "then": {"type": "array", "items": {"$ref": "#/$defs/rule"}}}}},
           "otherwise": {"type": "array", "items": {"$ref": "#/$defs/rule"}}}}
      ]
    },
    "interaction": {
      "type": "object", "additionalProperties": false, "required": ["identity", "source", "rules", "anchors", "unresolved"],
      "properties": {
        "identity": {"type": "object", "additionalProperties": false, "required": ["key", "revision"],
                     "properties": {"key": {"type": "string", "pattern": "^[a-z0-9_-]+:interaction/[a-z0-9_]+(/[a-z0-9_]+)*$"},
                                    "revision": {"type": "string", "minLength": 1}}},
        "source": {"type": "object", "additionalProperties": false, "required": ["edge", "callback", "target_registrations"],
                   "properties": {"edge": {"enum": ["ON_ENTER", "ON_LEAVE", "ON_CONTACT", "USE", "ON_DEATH", "ON_KILL"]},
                                  "callback": {"type": "string"},
                                  "target_registrations": {"type": "array", "items": {"type": "string"}}}},
        "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
        "anchors": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["key", "source_position"],
          "properties": {"key": {"$ref": "#/$defs/anchor_key"},
                         "source_position": {"type": "object", "additionalProperties": false, "required": ["x", "y", "z"],
                                             "properties": {"x": {"type": "integer"}, "y": {"type": "integer"},
                                                            "z": {"type": "integer", "minimum": 0, "maximum": 15}}}}}},
        "unresolved": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["line", "reason"],
          "properties": {"line": {"type": "integer", "minimum": 1}, "reason": {"type": "string"}}}}
      }
    }
  }
}
