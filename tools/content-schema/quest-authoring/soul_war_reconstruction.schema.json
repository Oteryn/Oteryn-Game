{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oteryn:schema/soul-war-reconstruction/v1",
  "title": "Soul War faithful-reimplementation evidence packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "quest",
    "classification",
    "runtime_activation",
    "target_profile",
    "source_policy",
    "source_files",
    "video_sources",
    "progression",
    "mechanics",
    "known_donor_defects",
    "existing_oteryn_baseline",
    "runtime_holds"
  ],
  "properties": {
    "schema": { "const": "OTERYN_SOUL_WAR_RECONSTRUCTION/v1" },
    "quest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "revision", "display_name"],
      "properties": {
        "key": { "const": "oteryn:quest.soul_war_quest" },
        "revision": { "const": "quest-r1" },
        "display_name": { "const": "Soul War Quest" }
      }
    },
    "classification": { "const": "FAITHFUL_REIMPLEMENTATION_EVIDENCE_NOT_RUNTIME_ADMISSION" },
    "runtime_activation": { "const": false },
    "target_profile": { "const": "OTERYN_NATIVE_QUEST_AND_ENCOUNTER_AUTHORING" },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "primary_revision", "crosscheck", "crosscheck_revision", "behavioral_evidence", "conflict_rule"],
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "primary_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "crosscheck": { "type": "string", "minLength": 1 },
        "crosscheck_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "behavioral_evidence": { "type": "string", "minLength": 1 },
        "conflict_rule": { "type": "string", "minLength": 1 }
      }
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "repository", "revision", "path", "blob_sha1"],
        "properties": {
          "kind": { "const": "git" },
          "repository": { "const": "zimbadev/crystalserver" },
          "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "path": { "type": "string", "minLength": 1 },
          "blob_sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
        }
      }
    },
    "video_sources": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["part", "video_id", "focus", "dense_windows"],
        "properties": {
          "part": { "type": "integer", "minimum": 1, "maximum": 6 },
          "video_id": { "type": "string", "minLength": 6 },
          "focus": { "type": "string", "minLength": 1 },
          "dense_windows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                { "type": "string" },
                { "type": "string" },
                { "type": "string" }
              ],
              "items": false
            }
          }
        }
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": true,
      "required": ["admission", "mini_bosses", "mini_boss_order", "taints", "taint_reset_seconds", "final_access", "mini_boss_retry_seconds", "megalomania_retry_seconds", "final_reward", "completion_npc"]
    },
    "mechanics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "scope", "classification", "chosen", "evidence"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "scope": { "type": "string", "minLength": 1 },
          "classification": {
            "enum": ["PROVEN", "CONFLICT", "VIDEO_PROVEN_SOURCE_MAPPING_PENDING", "VIDEO_PROVEN_SOURCE_PRESENT", "OTERYN_ACCEPTED"]
          },
          "chosen": {},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["kind"]
            }
          }
        }
      }
    },
    "known_donor_defects": { "type": "array" },
    "existing_oteryn_baseline": { "type": "object" },
    "runtime_holds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
