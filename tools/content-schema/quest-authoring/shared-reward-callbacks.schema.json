{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "OTERYN_QUEST_REWARD_CALLBACKS/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "callbacks"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "callbacks": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/callback"
      }
    },
    "tracks": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/trackDeclaration"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "count"
      ],
      "properties": {
        "item": {
          "type": "string",
          "pattern": "^oteryn:item\\.[a-z0-9._/:-]+$",
          "maxLength": 256
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "give": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "count"
      ],
      "properties": {
        "item": {
          "type": "string",
          "pattern": "^oteryn:item\\.[a-z0-9._/:-]+$",
          "maxLength": 256
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "contents": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "decay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "duration_millis",
            "target"
          ],
          "properties": {
            "duration_millis": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "target": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "family",
                    "key",
                    "revision"
                  ],
                  "properties": {
                    "family": {
                      "const": "Item"
                    },
                    "key": {
                      "type": "string",
                      "pattern": "^oteryn:item\\.[a-z0-9._/:-]+$",
                      "maxLength": 256
                    },
                    "revision": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "outfit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outfit",
        "addons"
      ],
      "properties": {
        "outfit": {
          "type": "string",
          "pattern": "^oteryn:outfit\\.[a-z0-9_]+$",
          "maxLength": 160
        },
        "addons": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track",
        "minimum",
        "maximum",
        "set"
      ],
      "properties": {
        "track": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^oteryn:[a-z0-9._/:-]+$"
        },
        "minimum": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "maximum": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "set": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "preserve": {
          "type": "boolean"
        }
      }
    },
    "callback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "quest",
        "npc",
        "keywords",
        "topic",
        "next_topic",
        "storage",
        "take",
        "reply",
        "sources"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^oteryn:quest-reward/[a-z0-9_/-]+$"
        },
        "quest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^oteryn:[a-z0-9._/:-]+$"
        },
        "npc": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^oteryn:npc\\.[a-z0-9_]+$"
        },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "topic": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "next_topic": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "storage": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/storage"
          }
        },
        "take": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/input"
          }
        },
        "give": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/give"
            }
          ]
        },
        "outfit": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/outfit"
            }
          ]
        },
        "reply": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "achievement": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 128,
              "pattern": "^oteryn:achievement/[a-z0-9_/-]+$"
            }
          ]
        },
        "present": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/input"
          }
        },
        "requires": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "repeatable": {
          "type": "boolean",
          "default": false
        },
        "achievement_once": {
          "type": "boolean",
          "default": false
        },
        "cooldown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "track",
            "seconds"
          ],
          "properties": {
            "track": {
              "type": "string",
              "pattern": "^oteryn:",
              "maxLength": 128
            },
            "seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31536000
            }
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "count"
      ],
      "properties": {
        "item": {
          "type": "string",
          "pattern": "^oteryn:item\\.[a-z0-9._/:-]+$",
          "maxLength": 256
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track",
        "minimum",
        "maximum"
      ],
      "properties": {
        "track": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^oteryn:[a-z0-9._/:-]+$"
        },
        "minimum": {
          "type": "integer"
        },
        "maximum": {
          "type": "integer"
        }
      }
    },
    "trackDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "quest",
        "initial",
        "min",
        "max",
        "sources"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^oteryn:[a-z0-9._/:-]+$",
          "maxLength": 128
        },
        "quest": {
          "type": "string",
          "pattern": "^oteryn:[a-z0-9._/:-]+$",
          "maxLength": 128
        },
        "initial": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "min": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "max": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    }
  }
}
