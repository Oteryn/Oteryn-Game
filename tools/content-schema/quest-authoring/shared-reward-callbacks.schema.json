{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "OTERYN_QUEST_REWARD_CALLBACKS/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "callbacks"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "callbacks": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/callback"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "count"
      ],
      "properties": {
        "item": {
          "type": "string",
          "pattern": "^oteryn:item\\.[a-z0-9._/:-]+$",
          "maxLength": 256
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "give": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "count"
      ],
      "properties": {
        "item": {
          "type": "string",
          "pattern": "^oteryn:item\\.[a-z0-9._/:-]+$",
          "maxLength": 256
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "contents": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "outfit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outfit",
        "addons"
      ],
      "properties": {
        "outfit": {
          "type": "string",
          "pattern": "^oteryn:outfit\\.[a-z0-9_]+$",
          "maxLength": 160
        },
        "addons": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track",
        "minimum",
        "maximum",
        "set"
      ],
      "properties": {
        "track": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^oteryn:[a-z0-9._/:-]+$"
        },
        "minimum": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "maximum": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "set": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "preserve": {
          "type": "boolean"
        },
        "set_if": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        }
      }
    },
    "callback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "quest",
        "npc",
        "keywords",
        "topic",
        "next_topic",
        "storage",
        "take",
        "reply",
        "sources"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^oteryn:quest-reward/[a-z0-9_/-]+$"
        },
        "quest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^oteryn:[a-z0-9._/:-]+$"
        },
        "npc": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^oteryn:npc\\.[a-z0-9_]+$"
        },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "topic": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "next_topic": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "storage": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/storage"
          }
        },
        "take": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/input"
          }
        },
        "give": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/give"
            }
          ]
        },
        "outfit": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/outfit"
            }
          ]
        },
        "reply": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "achievement": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 128,
              "pattern": "^oteryn:achievement/[a-z0-9_/-]+$"
            }
          ]
        },
        "repeatable": {
          "type": "boolean",
          "default": false
        },
        "present": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/input"
          }
        },
        "fee": {
          "$ref": "#/$defs/fee"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "count"
      ],
      "properties": {
        "item": {
          "type": "string",
          "pattern": "^oteryn:item\\.[a-z0-9._/:-]+$",
          "maxLength": 256
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "fee": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gold",
        "include_bank"
      ],
      "properties": {
        "gold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        },
        "include_bank": {
          "type": "boolean"
        }
      }
    }
  }
}
