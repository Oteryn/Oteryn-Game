    "protection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "armor": {
          "type": "integer"
        },
        "resistances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resistance"
          },
          "minItems": 0
        },
        "condition_suppressions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conditionSuppression"
          },
          "minItems": 0
        }
      },
