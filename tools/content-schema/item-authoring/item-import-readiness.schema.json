{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oteryn:item-import-readiness:candidate:1",
  "title": "Oteryn Item import readiness candidate v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      },
      "minItems": 1
    }
  },
  "required": [
    "sources",
    "entries"
  ],
  "$defs": {
    "key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_.:/-]+$",
      "maxLength": 512,
      "description": "Namespaced Oteryn authoring key; source numeric IDs are provenance only."
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "maxLength": 512
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "key",
        "revision"
      ]
    },
    "ItemRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "Item"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "family",
        "key",
        "revision"
      ]
    },
    "AbilityRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "Ability"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "family",
        "key",
        "revision"
      ]
    },
    "EffectRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "Effect"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "family",
        "key",
        "revision"
      ]
    },
    "InteractionRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "Interaction"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "family",
        "key",
        "revision"
      ]
    },
    "DocumentRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "Document"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "family",
        "key",
        "revision"
      ]
    },
    "ProficiencyRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "Proficiency"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "family",
        "key",
        "revision"
      ]
    },
    "PresentationRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "Presentation"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "family",
        "key",
        "revision"
      ]
    },
    "bool": {
      "type": "boolean"
    },
    "ms": {
      "type": "integer",
      "minimum": 1,
      "description": "Positive duration in milliseconds; no implicit unit conversion."
    },
    "ratio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer"
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "description": "Exact rational in lowest terms."
    },
    "nonnegativeRatio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "description": "Exact rational in lowest terms."
    },
    "percent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "description": "Exact percentage points in [0,100], enforced semantically."
    },
    "damageType": {
      "enum": [
        "physical",
        "energy",
        "earth",
        "fire",
        "life_drain",
        "mana_drain",
        "drowning",
        "ice",
        "holy",
        "death",
        "agony",
        "neutral",
        "healing"
      ]
    },
    "assetBinding": {
      "$ref": "#/$defs/key"
    },
    "weight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "maxLength": 64
        },
        "unit": {
          "enum": [
            "oz",
            "g"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "description": "Exact nonnegative decimal string plus explicit unit."
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grammar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "article": {
              "type": "string",
              "minLength": 0
            },
            "plural": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": []
        },
        "inspection_description": {
          "type": "string",
          "minLength": 1
        },
        "flavor_text": {
          "type": "string",
          "minLength": 1
        },
        "sounds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "appearance_binding": {
          "$ref": "#/$defs/key"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "projectile_effect": {
          "$ref": "#/$defs/key"
        },
        "attack_effect": {
          "$ref": "#/$defs/key"
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemRef"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": []
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item_class": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "primary": {
          "type": "string",
          "minLength": 1
        },
        "secondary": {
          "type": "string",
          "minLength": 1
        },
        "tertiary": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "item_class",
        "primary"
      ]
    },
    "physical": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weight": {
          "$ref": "#/$defs/weight"
        },
        "movable": {
          "$ref": "#/$defs/bool"
        },
        "pickupable": {
          "$ref": "#/$defs/bool"
        }
      },
      "required": []
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stackable": {
          "$ref": "#/$defs/bool"
        },
        "max_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "stackable",
        "max_count"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "stackable": {
                "const": true
              }
            },
            "required": [
              "stackable"
            ]
          },
          "then": {
            "properties": {
              "max_count": {
                "minimum": 2
              }
            }
          },
          "else": {
            "properties": {
              "max_count": {
                "const": 1
              }
            }
          }
        }
      ]
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_level": {
          "type": "integer",
          "minimum": 0
        },
        "min_magic_level": {
          "type": "integer",
          "minimum": 0
        },
        "vocations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "enforcement_mode": {
          "enum": [
            "on_equip",
            "on_use",
            "both"
          ]
        }
      },
      "required": [
        "enforcement_mode"
      ]
    },
    "equipmentPattern": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pattern_id": {
          "type": "integer",
          "minimum": 0
        },
        "slot": {
          "enum": [
            "head",
            "neck",
            "back",
            "armor",
            "right_hand",
            "left_hand",
            "legs",
            "feet",
            "ring",
            "ammo",
            "extra"
          ]
        },
        "hands": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "reserved_slots": {
          "type": "array",
          "items": {
            "enum": [
              "head",
              "neck",
              "back",
              "armor",
              "right_hand",
              "left_hand",
              "legs",
              "feet",
              "ring",
              "ammo",
              "extra"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "vocations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "min_level": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "pattern_id",
        "slot",
        "hands"
      ]
    },
    "equipment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pattern_id": {
          "type": "integer",
          "minimum": 0
        },
        "slot": {
          "enum": [
            "head",
            "neck",
            "back",
            "armor",
            "right_hand",
            "left_hand",
            "legs",
            "feet",
            "ring",
            "ammo",
            "extra"
          ]
        },
        "hands": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "reserved_slots": {
          "type": "array",
          "items": {
            "enum": [
              "head",
              "neck",
              "back",
              "armor",
              "right_hand",
              "left_hand",
              "legs",
              "feet",
              "ring",
              "ammo",
              "extra"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "vocations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "min_level": {
          "type": "integer",
          "minimum": 0
        },
        "patterns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/equipmentPattern"
          },
          "minItems": 1
        }
      },
      "required": [],
      "oneOf": [
        {
          "required": [
            "slot",
            "hands"
          ],
          "not": {
            "required": [
              "patterns"
            ]
          }
        },
        {
          "required": [
            "patterns"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "pattern_id"
                ]
              },
              {
                "required": [
                  "slot"
                ]
              },
              {
                "required": [
                  "hands"
                ]
              },
              {
                "required": [
                  "reserved_slots"
                ]
              },
              {
                "required": [
                  "groups"
                ]
              },
              {
                "required": [
                  "vocations"
                ]
              },
              {
                "required": [
                  "min_level"
                ]
              }
            ]
          }
        }
      ],
      "description": "Use the compact slot/hands form for one pattern or patterns[] when equip rules differ by vocation/level."
    },
    "elementalAttack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "damage_type": {
