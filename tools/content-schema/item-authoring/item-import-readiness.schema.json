        "flat": {
          "type": "integer"
        },
        "percent": {
          "$ref": "#/$defs/percent"
        }
      },
      "required": [
        "damage_type"
      ],
      "anyOf": [
        {
          "required": [
            "flat"
          ]
        },
        {
          "required": [
            "percent"
          ]
