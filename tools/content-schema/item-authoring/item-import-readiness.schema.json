          "enum": [
            "none",
            "consume_ammunition",
            "consume_charge",
            "consume_item"
          ]
        },
        "break_chance_percent": {
          "$ref": "#/$defs/percent"
        },
        "chain": {
          "$ref": "#/$defs/chain"
        }
      },
      "required": [
        "weapon_type"
      ]
    },
    "resistance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "damage_type": {
          "$ref": "#/$defs/damageType"
        },
        "reduction_percent": {
          "$ref": "#/$defs/ratio"
        },
        "scope": {
          "enum": [
            "direct",
            "field",
            "all"
          ]
        }
      },
      "required": [
        "damage_type",
        "reduction_percent",
        "scope"
      ]
    },
    "conditionSuppression": {
      "type": "object",
      "additionalProperties": false,
