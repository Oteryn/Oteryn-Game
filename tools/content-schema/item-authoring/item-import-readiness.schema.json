          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "scope": {
          "enum": [
            "direct",
            "field",
            "all"
          ]
        }
      },
      "required": [
        "condition",
        "scope"
      ]
