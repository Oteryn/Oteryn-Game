{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Official client flat asset inventory with optional numeric sound mapping",
  "type": "object",
  "required": ["schema", "source", "archive_sha256", "file_count", "total_bytes", "files"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "OTERYN_CLIENT_ASSET_MANIFEST/v1"},
    "source": {"type": "string"},
    "archive_sha256": {"$ref": "#/$defs/hash"},
    "file_count": {"type": "integer", "minimum": 0},
    "total_bytes": {"type": "integer", "minimum": 0},
    "files": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "bytes", "sha256"],
        "properties": {
          "name": {"$ref": "#/$defs/name"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "ambient_cues": {
      "type": "object", "maxProperties": 65535,
      "propertyNames": {"pattern": "^[1-9][0-9]{0,4}$"},
      "additionalProperties": {
        "type": "array", "minItems": 1, "maxItems": 128,
        "items": {"$ref": "#/$defs/name"}
      }
    },
    "sound_data": {"$ref": "#/$defs/name"},
    "sound_cues": {
      "type": "object", "minProperties": 1, "maxProperties": 65535,
      "propertyNames": {"pattern": "^[1-9][0-9]{0,4}$"},
      "additionalProperties": {
        "type": "array", "minItems": 1, "maxItems": 128,
        "items": {"$ref": "#/$defs/name"}
      }
    }
  },
  "dependentRequired": {"ambient_cues": ["sound_data"], "sound_data": ["sound_cues"], "sound_cues": ["sound_data"]},
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "name": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\:\\u0000]+$", "not": {"enum": [".", ".."]}}
  }
}
