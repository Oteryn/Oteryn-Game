          "repository": "zimbadev/crystalserver",
          "revision": "201189f871d23597b82caf88fd611454a2ddefb8",
          "path": "data-global/npc/mayor_pocaro.lua",
          "line": 153,
          "sha256": "26c02f928e72aef3e684028c5cf03128481478ff87f96095674a5141aeae2618"
        }
      },
      "farewell": {
        "text": "Keep your head down out there.",
        "source": {
          "repository": "zimbadev/crystalserver",
          "revision": "201189f871d23597b82caf88fd611454a2ddefb8",
          "path": "data-global/npc/mayor_pocaro.lua",
