  "greetings": [
    {
      "npc": "oteryn:npc.captain_corsarah",
      "variants": {},
      "greet": {
        "text": "Welcome on board, |PLAYERNAME|. You want to sail to {Venore}?",
        "source": {
          "repository": "zimbadev/crystalserver",
          "revision": "201189f871d23597b82caf88fd611454a2ddefb8",
          "path": "data-global/npc/captain_corsarah.lua",
          "line": 77,
          "sha256": "2010a7bb0d69b06a70a08256496e6df75af918b0c1c8253496128292b9c15ace"
        }
      },
      "farewell": {
        "text": "Good bye. Recommend us if you were satisfied with our service.",
        "source": {
          "repository": "zimbadev/crystalserver",
          "revision": "201189f871d23597b82caf88fd611454a2ddefb8",
          "path": "data-global/npc/captain_corsarah.lua",
          "line": 78,
          "sha256": "2010a7bb0d69b06a70a08256496e6df75af918b0c1c8253496128292b9c15ace"
        }
      },
      "walkaway": {
        "text": "Good bye then.",
        "source": {
          "repository": "zimbadev/crystalserver",
          "revision": "201189f871d23597b82caf88fd611454a2ddefb8",
          "path": "data-global/npc/captain_corsarah.lua",
          "line": 79,
          "sha256": "2010a7bb0d69b06a70a08256496e6df75af918b0c1c8253496128292b9c15ace"
        }
      }
    },
    {
      "npc": "oteryn:npc.mayor_pocaro",
      "variants": {},
      "greet": {
        "text": "Ah, another one drawn here by the promise of moonsilver, I presume. I am the mayor of what remains of this {settlement}.",
