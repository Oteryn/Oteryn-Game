    {
      "npc": "oteryn:npc.wayland_smythers",
      "variants": {},
      "greet": {
        "text": "Ah, a visitor. Allow me to introduce myself. Wayland Smythers, in service of science. I am here in search of esteemed heroes, such as yourself, to avert a grave {danger}.",
        "source": {
          "repository": "zimbadev/crystalserver",
          "revision": "201189f871d23597b82caf88fd611454a2ddefb8",
          "path": "data-global/npc/wayland_smythers.lua",
