            "kind": "npc_dialogue",
            "callback": {
              "key": "oteryn:quest-reward/authored/top-of-the-city/restart-pursuit",
              "quest": "oteryn:quest.authored.top_of_the_city_quest",
              "npc": "oteryn:npc.iriana",
              "keywords": [
                "hi",
                "hello"
              ],
              "topic": 0,
              "next_topic": 0,
              "storage": [
                { "track": "oteryn:quest-progress/authored/top-of-the-city/stage", "minimum": 1, "maximum": 1, "set": 1, "preserve": true },
                { "track": "oteryn:quest-progress/authored/top-of-the-city/pursuit", "minimum": 11, "maximum": 11, "set": 0 }
              ],
              "take": [],
              "give": null,
              "outfit": null,
              "achievement": null,
              "reply": [
                "What happened?! Did you lose track of him? I'm sure he'll come back, he always does. Try to track him down from here once more."
