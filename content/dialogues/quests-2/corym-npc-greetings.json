    {
      "npc": "oteryn:npc.corym_ratter",
      "greet": {
        "text": "Welcome stranger! You might be surprised that I don't attack you immediately. The point is, that I think you could be useful to me. What you see in front of you is a great mine of the corym! ... We dig up all what mother earth delivers to us, valuable natural resources. But the yield is getting worse and here I need your {help}.",
        "source": {
          "repository": "opentibiabr/canary",
          "revision": "04b83b512114bfd888000d6e1433ed8ecaec7c5b",
          "path": "data-otservbr-global/npc/corym_ratter.lua",
          "line": 60,
          "sha256": "6cdadfe5c542508fd7c10bcff7f752fd42528a1b8ab0b852de1ceae7b3869f0a"
        }
      },
      "farewell": {
        "text": "Good bye, |PLAYERNAME|.",
