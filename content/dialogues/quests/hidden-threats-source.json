          "source": "zimbadev/crystalserver@201189f871d23597b82caf88fd611454a2ddefb8:data-global/npc/corym_butler.lua:58-60"
        },
        {
          "kind": "setMessage",
          "event": "MESSAGE_GREET",
          "parts": [
            "We have to dig up valuable resources, but don't get enough to eat. The situation is terrible."
          ],
