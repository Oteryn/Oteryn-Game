  "dialogues": [
    {
      "source_npc_name": "Benny The Baker",
      "city": "Carlin",
      "utterances": [
        {
          "kind": "reply",
          "text": "So far, %d of the %d Sweet and Sugary Substances have been delivered here in %s.",
          "source": "zimbadev/crystalserver@201189f871d23597b82caf88fd611454a2ddefb8:data-global/npc/benny_the_baker.lua:65"
        },
        {
          "kind": "reply",
          "text": "So far, %d of the %d Cake Golems have been lured to the machines.",
          "source": "zimbadev/crystalserver@201189f871d23597b82caf88fd611454a2ddefb8:data-global/npc/benny_the_baker.lua:68"
        },
        {
          "kind": "reply",
          "text": "I'm not collecting anything right now, but thanks for asking!",
          "source": "zimbadev/crystalserver@201189f871d23597b82caf88fd611454a2ddefb8:data-global/npc/benny_the_baker.lua:71"
        },
        {
          "kind": "reply",
          "text": "Hmm, I don't quite know what to do with that yet.",
          "source": "zimbadev/crystalserver@201189f871d23597b82caf88fd611454a2ddefb8:data-global/npc/benny_the_baker.lua:75"
        },
        {
          "kind": "reply",
          "text": "You don't have any Sweet and Sugary Substances on you. Go defeat some Cake Golems!",
          "source": "zimbadev/crystalserver@201189f871d23597b82caf88fd611454a2ddefb8:data-global/npc/benny_the_baker.lua:81"
        },
        {
          "kind": "reply",
          "text": "We already have all the substances we need, thank you though!",
          "source": "zimbadev/crystalserver@201189f871d23597b82caf88fd611454a2ddefb8:data-global/npc/benny_the_baker.lua:88"
        },
        {
          "kind": "reply",
          "text": "Wonderful, thank you! You delivered %d substance(s). (%d/%d total delivered)",
          "source": "zimbadev/crystalserver@201189f871d23597b82caf88fd611454a2ddefb8:data-global/npc/benny_the_baker.lua:97"
        },
        {
          "kind": "greet",
          "text": "I wonder if we will make it this year! Say {substance} if you want to deliver Sweet and Sugary Substances, or ask me about the {mass} of substances delivered or the {base} material lured, if you want to know how the World Quest is going.",
          "source": "zimbadev/crystalserver@201189f871d23597b82caf88fd611454a2ddefb8:data-global/npc/benny_the_baker.lua:104"
        },
        {
          "kind": "farewell",
          "text": "Good luck out there!",
          "source": "zimbadev/crystalserver@201189f871d23597b82caf88fd611454a2ddefb8:data-global/npc/benny_the_baker.lua:105"
        }
      ]
    },
