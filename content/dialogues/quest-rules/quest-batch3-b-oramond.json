    {
      "key": "oteryn:quest-npc/oramond_quest/chavis/root-lore",
      "quest": "oteryn:quest.oramond_quest",
      "npc": "oteryn:npc.chavis",
      "trigger": "say",
      "keywords": [
        "root"
      ],
      "guards": [],
      "reply": [
        "They are nutritious, cost nothing and are good for the body hair. If you can bring us bundles of five juicy roots each - we will make it worth your while for the {magistrate}."
      ],
      "effects": [
        {
          "kind": "set_topic",
          "value": 0
        }
      ],
      "sources": [
        "crystal:201189f871d23597b82caf88fd611454a2ddefb8:data-global/npc/chavis.lua:102"
