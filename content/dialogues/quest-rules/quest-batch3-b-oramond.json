      "quest": "oteryn:quest.oramond_quest",
      "npc": "oteryn:npc.doubleday",
      "trigger": "say",
      "keywords": [
        "yes"
      ],
      "guards": [],
      "reply": [
        "Good! Quite good! You know, there are actually several things I want you to address. ...",
        "First, there is the problem with {communication}, second I need someone to {probe} part of the sewers and last - {combinatorics}!"
      ],
      "effects": [
        {
          "kind": "set_topic",
          "value": 2
        }
      ],
      "sources": [
        "crystal:201189f871d23597b82caf88fd611454a2ddefb8:data-global/npc/doubleday.lua:71"
      ],
      "topics": [
        1
      ],
      "exclude_keywords": [
        "experiment"
      ]
    },
