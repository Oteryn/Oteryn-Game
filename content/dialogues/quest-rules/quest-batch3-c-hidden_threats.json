    {
      "key": "oteryn:quest-npc/tibia_tales/corym_servant/greet-start",
      "quest": "oteryn:quest.tibia_tales",
      "npc": "oteryn:npc.corym_servant",
      "trigger": "greet",
      "keywords": [],
      "guards": [
        {
          "kind": "storage",
          "track": "oteryn:quest-progress/quest/u11_50/hidden_threats/quest_line",
          "op": "eq",
          "value": 1
        }
      ],
      "reply": [
        "We work as hard we can, my master! Wait, I haven't seen you here before. You were sent by the Corym Ratter, I see. He misses the courage to visit us and find the reason for {decreasing resources}? He's the coward I have expected."
      ],
      "effects": [],
      "sources": [
        "canary:04b83b512114bfd888000d6e1433ed8ecaec7c5b:data-otservbr-global/npc/corym_servant.lua:60"
      ]
    },
    {
      "key": "oteryn:quest-npc/tibia_tales/corym_servant/all-rescued",
      "quest": "oteryn:quest.tibia_tales",
      "npc": "oteryn:npc.corym_servant",
      "trigger": "greet",
      "keywords": [],
      "guards": [
        {
          "kind": "storage",
          "track": "oteryn:quest-progress/quest/u11_50/hidden_threats/corym_rescue_mission",
          "op": "eq",
          "value": 8
        },
        {
          "kind": "storage",
          "track": "oteryn:quest-progress/quest/u11_50/hidden_threats/quest_line",
          "op": "eq",
          "value": 3
        }
      ],
      "reply": [
        "Well done! The riot progesses! No fight without weapons. In the mine the temperature is quite high, higher as expected in this depth. Therefore we need heat-resistent weapons and armors. ...",
        "This effect can be reached by adding rare earth to the common materials. But this can only be found in the stomaches of stonerefiners. 20 of these should be enough. Well, I see you have already collected enough of them! Would you give it to me?"
      ],
      "effects": [
        {
          "kind": "set",
          "track": "oteryn:quest-progress/quest/u11_50/hidden_threats/quest_line",
          "value": 4
        }
      ],
      "sources": [
        "canary:04b83b512114bfd888000d6e1433ed8ecaec7c5b:data-otservbr-global/npc/corym_servant.lua:64"
      ]
    },
    {
