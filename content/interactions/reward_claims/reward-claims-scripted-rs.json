{"family":"RewardClaim","records":[{"definition":{"claim":{"per":"character","repeat":{"kind":"once"}},"identity":{"key":"oteryn:reward-claim.kv.rapier","revision":"reward-claim-r1"},"placements":[{"appearance_tibia_id":2473,"reward":{"items":[{"count":1,"item":{"family":"Item","key":"oteryn:item.tibia.i3272","revision":"definition-r1"}}]},"source_binding":{"legacy_unique_ids":[{"server":"crystalserver","unique_id":14042}],"project_position":{"x":32099,"y":32198,"z":9}}}],"provenance":{"pilot_key":"canary:reward-claim/kv/rapier","pilot_revision":"crystal-201189f-scripted-rs-v1"},"quest":{"family":"Quest","key":"canary:quest/rapier_quest","revision":"canary-04b83b51+crystalserver-9f5a72c6"},"readiness":"ready"}},{"definition":{"claim":{"per":"character","repeat":{"kind":"once"}},"definition_profile":"scripted_rs_v1","identity":{"key":"oteryn:reward-claim.kv.smallsapphire","revision":"reward-claim-r1"},"native_contents":{"native_unique_id":64993,"placements":[{"capacity":8,"completion":{"key":"smallSapphire","kind":"quest_kv"},"contents":[{"count":1,"item":{"family":"Item","key":"oteryn:item.tibia.i3029","revision":"definition-r1"}},{"count":50,"item":{"family":"Item","key":"oteryn:item.tibia.i3031","revision":"definition-r1"}},{"count":1,"item":{"family":"Item","key":"oteryn:item.tibia.i2822","revision":"definition-r1"},"text":"Polly, barmaid in Port Hope (likes shiny things, doesn't like beer)\nSally, seamstress in Venore (never paid for that coat she made)\nDorothy, shipwrecked in Cormaya (cute, naive, definitely waiting)\nAngelica, Laguna Island (memo: get my cutlass back from her)\nTricia, Liberty Bay (has an angry brother, bring pistol)\nSuzanne, Drefia (tastes of cherry, have to visit again)"},{"count":1,"item":{"family":"Item","key":"oteryn:item.tibia.i637","revision":"definition-r1"},"text":"To Captain Starbird, Port Hope, Juggling Mermaid's Inn.\n\nRodney, ye hairy ol' walrus, I hope this finds ye in good health and spirits and a fair maiden in each arm, too, I wager.\n As we had to scarper from that last and somewhat heated appointment with the fleet, I took the liberty of deducting my travel expenses from the contents of this here treasure chest. Shiver me timbers, what a blow my ol' Red Ruby took! It's three months' repair at least before venturing out for the next likely booty for us.\nWell, take the rest for a merry round of quaffing with the boys, and we'll meet at the usual place at the usual time.\n\nYohoho,\n\nCaptain Jack Rumgut"}],"root":{"family":"Item","key":"oteryn:item.tibia.i2853","revision":"definition-r1"},"unique_id":null}],"revision":"tibiawiki-small-sapphire-v1","schema":"OTERYN_NATIVE_CONTAINER_REWARD/v1","source_sha256":"229eb3979fe64d69d726104122a3d76e2c281902777ef151cc796834c38a4291"},"placements":[{"appearance_tibia_id":2472,"reward":{"container":{"family":"Item","key":"oteryn:item.tibia.i2853","revision":"definition-r1"},"items":[{"count":1,"item":{"family":"Item","key":"oteryn:item.tibia.i3029","revision":"definition-r1"}},{"count":50,"item":{"family":"Item","key":"oteryn:item.tibia.i3031","revision":"definition-r1"}},{"count":1,"item":{"family":"Item","key":"oteryn:item.tibia.i2822","revision":"definition-r1"}},{"count":1,"item":{"family":"Item","key":"oteryn:item.tibia.i637","revision":"definition-r1"}}]},"source_binding":{"legacy_unique_ids":[],"project_position":{"x":32962,"y":32429,"z":7}}}],"provenance":{"source_packet":"tools/content-schema/reward-claim-authoring/small_sapphire_source.json","source_sha256":"229eb3979fe64d69d726104122a3d76e2c281902777ef151cc796834c38a4291"},"quest":{"family":"Quest","key":"oteryn:quest.authored.small_sapphire_quest","revision":"authored-r1"},"readiness":"ready"}}],"schema":"OTERYN_REWARD_CLAIM_SHARD/v1","shard":{"count":2,"end":1,"index":0,"start":0}}
